---

---

<!-- Oracle Button -->
<div class="oracle-btn fixed bottom-10 right-10 z-50 transition-opacity duration-500">
  <button id="oracle-trigger" class="bg-white/80 backdrop-blur-md border border-jade text-jade hover:bg-jade hover:text-white w-14 h-24 rounded-full shadow-xl flex flex-col items-center justify-center transition-all duration-300 hover:-translate-y-2 group overflow-hidden active:scale-95">
    <div class="absolute inset-0 bg-gradient-to-t from-jade/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    <span class="material-symbols-outlined text-2xl mb-2 animate-pulse">ifl</span>
    <span class="i18n font-display text-[9px] font-bold uppercase tracking-widest vertical-text h-10 leading-3 opacity-80 group-hover:opacity-100" data-en="Oracle" data-zh="卦">Oracle</span>
  </button>
</div>

<!-- Oracle Modal -->
<div id="oracle-modal" class="oracle-modal fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="oracle-content relative bg-white rounded-lg shadow-2xl max-w-sm w-full transform scale-95 transition-transform duration-300 overflow-hidden">
    <!-- Header -->
    <div class="p-6 text-center border-b border-text-main/10 bg-gradient-to-b from-jade/5 to-transparent">
      <div id="oracle-hexagram" class="text-7xl mb-2 text-jade animate-float">☰</div>
      <h3 id="oracle-name" class="font-display text-2xl font-bold text-text-main">乾</h3>
      <p id="oracle-pinyin" class="font-mono text-xs text-text-subtle mt-1">Qián - The Creative</p>
    </div>
    
    <!-- Content -->
    <div class="p-6">
      <div class="mb-4">
        <h4 class="font-mono text-xs text-jade uppercase tracking-wider mb-2">卦辞 · Judgment</h4>
        <p id="oracle-judgment" class="font-display text-sm text-text-main leading-relaxed italic">
          "元亨利贞。"
        </p>
      </div>
      
      <div class="mb-4">
        <h4 class="font-mono text-xs text-jade uppercase tracking-wider mb-2">象曰 · Image</h4>
        <p id="oracle-image" class="text-sm text-text-subtle leading-relaxed">
          天行健，君子以自强不息。
        </p>
      </div>
      
      <div class="p-4 bg-jade/5 rounded-lg border border-jade/10">
        <h4 class="font-mono text-xs text-cinnabar uppercase tracking-wider mb-2">今日启示 · Insight</h4>
        <p id="oracle-insight" class="text-sm text-text-main leading-relaxed">
          创造力与领导力的时刻。保持正直，大事可成。
        </p>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="p-4 border-t border-text-main/10 flex items-center justify-center bg-gray-50/50">
      <button id="oracle-close" class="px-6 py-2 bg-jade text-white text-xs font-mono rounded hover:bg-jade/90 transition-colors active:scale-95">
        <span class="i18n" data-en="Close" data-zh="关闭">关闭</span>
      </button>
    </div>
  </div>
</div>

<style>
  .vertical-text {
    writing-mode: vertical-rl;
    text-orientation: upright;
  }
  
  .oracle-modal.open {
    opacity: 1;
    pointer-events: auto;
  }
  
  .oracle-modal.open .oracle-content {
    transform: scale(1);
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>

<script>
  const hexagrams = [
    { symbol: '☰', name: '乾', pinyin: 'Qián - The Creative', judgment: '元亨利贞。', image: '天行健，君子以自强不息。', insight: '创造力与领导力的时刻。保持正直，大事可成。', insightEn: 'A time for creativity and leadership. Stay righteous, great things await.' },
    { symbol: '☷', name: '坤', pinyin: 'Kūn - The Receptive', judgment: '元亨，利牝马之贞。', image: '地势坤，君子以厚德载物。', insight: '顺势而为，以柔克刚。接纳与包容带来成功。', insightEn: 'Go with the flow. Acceptance and tolerance bring success.' },
    { symbol: '☵', name: '坎', pinyin: 'Kǎn - The Abysmal', judgment: '习坎，有孚，维心亨。', image: '水洊至，习坎；君子以常德行，习教事。', insight: '面对困难，保持信念。危机中蕴含机遇。', insightEn: 'Face difficulties with faith. Crisis contains opportunity.' },
    { symbol: '☲', name: '离', pinyin: 'Lí - The Clinging', judgment: '利贞，亨。畜牝牛，吉。', image: '明两作，离；大人以继明照于四方。', insight: '光明与智慧的时刻。清晰的思维带来成功。', insightEn: 'A time of clarity and wisdom. Clear thinking brings success.' },
    { symbol: '☳', name: '震', pinyin: 'Zhèn - The Arousing', judgment: '亨。震来虩虩，笑言哑哑。', image: '洊雷，震；君子以恐惧修省。', insight: '变革即将来临。保持警觉，准备迎接新开始。', insightEn: 'Change is coming. Stay alert, prepare for new beginnings.' },
    { symbol: '☴', name: '巽', pinyin: 'Xùn - The Gentle', judgment: '小亨，利有攸往，利见大人。', image: '随风，巽；君子以申命行事。', insight: '温和渗透胜过强力。耐心和坚持是关键。', insightEn: 'Gentle persistence wins. Patience is key.' },
    { symbol: '☶', name: '艮', pinyin: 'Gèn - Keeping Still', judgment: '艮其背，不获其身。', image: '兼山，艮；君子以思不出其位。', insight: '静止与冥想的时刻。停下来，反思当前处境。', insightEn: 'Time for stillness and reflection. Pause and assess.' },
    { symbol: '☱', name: '兑', pinyin: 'Duì - The Joyous', judgment: '亨，利贞。', image: '丽泽，兑；君子以朋友讲习。', insight: '喜悦与交流的时刻。分享带来更大的快乐。', insightEn: 'A time for joy and communication. Sharing multiplies happiness.' },
    { symbol: '䷀', name: '乾为天', pinyin: 'Qián Wéi Tiān', judgment: '元亨利贞。', image: '天行健，君子以自强不息。', insight: '纯阳之卦，代码如龙，架构当如天道运行。', insightEn: 'Pure yang energy. Code like a dragon, architecture like heaven.' },
    { symbol: '䷁', name: '坤为地', pinyin: 'Kūn Wéi Dì', judgment: '元亨，利牝马之贞。', image: '地势坤，君子以厚德载物。', insight: '承载万物，如同基础设施承载应用。', insightEn: 'Support all things, like infrastructure supports applications.' },
    { symbol: '䷂', name: '水雷屯', pinyin: 'Shuǐ Léi Zhūn', judgment: '元亨利贞，勿用有攸往。', image: '云雷，屯；君子以经纶。', insight: '创业维艰，如同项目初期。稳扎稳打。', insightEn: 'Beginnings are difficult. Build solid foundations.' },
    { symbol: '䷃', name: '山水蒙', pinyin: 'Shān Shuǐ Méng', judgment: '亨。匪我求童蒙，童蒙求我。', image: '山下出泉，蒙；君子以果行育德。', insight: '学习与成长的时刻。保持初学者心态。', insightEn: 'Time for learning. Keep a beginner\'s mind.' },
    { symbol: '䷄', name: '水天需', pinyin: 'Shuǐ Tiān Xū', judgment: '有孚，光亨，贞吉。', image: '云上于天，需；君子以饮食宴乐。', insight: '等待时机成熟。准备充分，时机自来。', insightEn: 'Wait for the right moment. Prepare well, timing will come.' },
    { symbol: '䷅', name: '天水讼', pinyin: 'Tiān Shuǐ Sòng', judgment: '有孚窒惕，中吉，终凶。', image: '天与水违行，讼；君子以作事谋始。', insight: '避免冲突，寻求共识。代码审查需谨慎。', insightEn: 'Avoid conflict, seek consensus. Code review with care.' },
    { symbol: '䷊', name: '地天泰', pinyin: 'Dì Tiān Tài', judgment: '小往大来，吉亨。', image: '天地交，泰；后以财成天地之道。', insight: '天地交泰，系统和谐运行。最佳部署时机。', insightEn: 'Heaven and earth in harmony. Optimal deployment time.' },
    { symbol: '䷋', name: '天地否', pinyin: 'Tiān Dì Pǐ', judgment: '否之匪人，不利君子贞。', image: '天地不交，否；君子以俭德辟难。', insight: '阻塞不通，需要重构。简化系统，度过难关。', insightEn: 'Blockage ahead. Refactor and simplify to overcome.' },
  ];

  const oracleTrigger = document.getElementById('oracle-trigger');
  const oracleModal = document.getElementById('oracle-modal');
  const oracleClose = document.getElementById('oracle-close');

  function castOracle() {
    const hex = hexagrams[Math.floor(Math.random() * hexagrams.length)];
    const lang = localStorage.getItem('cyber-zen-lang') || 'en';
    
    const hexagramEl = document.getElementById('oracle-hexagram');
    const nameEl = document.getElementById('oracle-name');
    const pinyinEl = document.getElementById('oracle-pinyin');
    const judgmentEl = document.getElementById('oracle-judgment');
    const imageEl = document.getElementById('oracle-image');
    const insightEl = document.getElementById('oracle-insight');
    
    if (hexagramEl) {
      hexagramEl.style.opacity = '0';
      hexagramEl.style.transform = 'scale(0.5) rotate(180deg)';
      
      setTimeout(() => {
        hexagramEl.textContent = hex.symbol;
        hexagramEl.style.opacity = '1';
        hexagramEl.style.transform = 'scale(1) rotate(0deg)';
      }, 300);
    }
    
    setTimeout(() => {
      if (nameEl) nameEl.textContent = hex.name;
      if (pinyinEl) pinyinEl.textContent = hex.pinyin;
      if (judgmentEl) judgmentEl.textContent = `"${hex.judgment}"`;
      if (imageEl) imageEl.textContent = hex.image;
      if (insightEl) insightEl.textContent = lang === 'zh' ? hex.insight : hex.insightEn;
    }, 200);
  }

  function openOracle() {
    castOracle();
    oracleModal?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeOracle() {
    oracleModal?.classList.remove('open');
    document.body.style.overflow = '';
  }

  oracleTrigger?.addEventListener('click', openOracle);
  oracleClose?.addEventListener('click', closeOracle);
  
  oracleModal?.addEventListener('click', (e) => {
    if (e.target === oracleModal) closeOracle();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && oracleModal?.classList.contains('open')) {
      closeOracle();
    }
  });

  function updateOracleI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.oracle-btn .i18n, #oracle-modal .i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateOracleI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateOracleI18n(customEvent.detail.lang);
  });
</script>
