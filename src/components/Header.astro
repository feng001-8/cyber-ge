---
interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

const navItems = [
  { href: '/', labelZh: '源起', labelEn: 'Origin', symbol: '☰', id: 'home' },
  { href: '/blog', labelZh: '论道', labelEn: 'Logic', symbol: '☱', id: 'blog' },
  { href: '/scriptures', labelZh: '藏经', labelEn: 'Scriptures', symbol: '☲', id: 'scriptures' },
  { href: '/projects', labelZh: '炼丹', labelEn: 'Alchemy', symbol: '☳', id: 'projects' },
  { href: '/archive', labelZh: '归藏', labelEn: 'Archive', symbol: '☶', id: 'archive' },
  { href: '/about', labelZh: '坐忘', labelEn: 'About', symbol: '☴', id: 'about' },
];
---

<header class="sticky top-0 z-50 w-full bg-background-light/90 backdrop-blur-md border-b border-[#E5E7EB] transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 sm:gap-3 group cursor-pointer active:scale-95 transition-transform">
      <span class="material-symbols-outlined text-jade text-2xl sm:text-3xl animate-pulse-slow">token</span>
      <h1 class="font-display font-bold text-lg sm:text-xl tracking-tight text-text-main">Cyber-GE</h1>
    </a>
    
    <nav class="hidden md:flex items-center gap-6 lg:gap-12">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class:list={[
            "nav-link flex items-center gap-2 text-sm font-medium transition-all duration-300 font-mono tracking-wide hover:scale-105",
            currentPage === item.id ? "text-jade" : "text-text-main hover:text-jade"
          ]}
          data-label-zh={item.labelZh}
          data-label-en={item.labelEn}
        >
          <span class="text-lg leading-none opacity-50">{item.symbol}</span>
          <span class="nav-label">{item.labelEn}</span>
        </a>
      ))}
    </nav>
    
    <div class="flex items-center gap-2 sm:gap-4">
      <!-- Language Toggle -->
      <button 
        id="lang-toggle"
        aria-label="Toggle Language" 
        class="flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 rounded-full hover:bg-black/5 text-text-main transition-all duration-300 border border-transparent hover:border-jade/20 active:scale-95"
        title="切换语言 / Switch Language"
      >
        <span class="lang-indicator font-mono text-xs font-medium">EN</span>
        <span class="text-text-subtle/50">/</span>
        <span class="lang-indicator font-mono text-xs text-text-subtle">中</span>
      </button>
      
      <button 
        aria-label="Toggle Theme" 
        class="hidden sm:flex items-center justify-center w-10 h-10 rounded-full hover:bg-black/5 text-text-main transition-colors duration-300 active:scale-95"
      >
        <span class="material-symbols-outlined text-2xl">balance</span>
      </button>
      <button class="md:hidden flex items-center justify-center w-10 h-10 text-text-main rounded-full hover:bg-black/5 transition-colors active:scale-95" id="mobile-menu-btn" aria-label="Toggle Menu">
        <span class="material-symbols-outlined menu-icon transition-transform duration-300">menu</span>
      </button>
    </div>
  </div>
  
  <!-- Mobile Menu with Animation -->
  <div id="mobile-menu" class="mobile-menu md:hidden border-t border-[#E5E7EB] bg-background-light/95 backdrop-blur-md overflow-hidden transition-all duration-300 max-h-0">
    <nav class="flex flex-col p-4 gap-1">
      {navItems.map((item, idx) => (
        <a 
          href={item.href}
          class:list={[
            "nav-link flex items-center gap-3 p-4 rounded-xl transition-all duration-300 font-mono active:scale-[0.98]",
            currentPage === item.id ? "text-jade bg-jade/10" : "text-text-main hover:bg-black/5"
          ]}
          data-label-zh={item.labelZh}
          data-label-en={item.labelEn}
          style={`animation-delay: ${idx * 0.05}s;`}
        >
          <span class="text-xl">{item.symbol}</span>
          <span class="nav-label text-base">{item.labelEn}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  #lang-toggle .lang-indicator:first-of-type {
    color: var(--color-jade);
    font-weight: 600;
  }
  
  body.lang-zh #lang-toggle .lang-indicator:first-of-type {
    color: var(--color-text-subtle);
    font-weight: 400;
  }
  
  body.lang-zh #lang-toggle .lang-indicator:last-of-type {
    color: var(--color-jade);
    font-weight: 600;
  }
  
  .mobile-menu.open {
    max-height: 400px;
  }
  
  .mobile-menu.open .nav-link {
    animation: slideIn 0.3s ease forwards;
    opacity: 0;
    transform: translateX(-10px);
  }
  
  @keyframes slideIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  
  .menu-icon.open {
    transform: rotate(90deg);
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = menuBtn?.querySelector('.menu-icon');
  const langToggle = document.getElementById('lang-toggle');
  
  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('open');
    menuIcon?.classList.toggle('open', isOpen);
    if (menuIcon) {
      menuIcon.textContent = isOpen ? 'close' : 'menu';
    }
  });

  // Close menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      menuIcon?.classList.remove('open');
      if (menuIcon) menuIcon.textContent = 'menu';
    });
  });

  function getCurrentLang(): 'en' | 'zh' {
    return localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  }

  function setLang(lang: 'en' | 'zh') {
    localStorage.setItem('cyber-zen-lang', lang);
    document.body.classList.remove('lang-en', 'lang-zh');
    document.body.classList.add(`lang-${lang}`);
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
    
    document.querySelectorAll('.nav-link').forEach(link => {
      const label = link.querySelector('.nav-label');
      if (label) {
        const el = link as HTMLElement;
        label.textContent = lang === 'zh' ? el.dataset.labelZh : el.dataset.labelEn;
      }
    });

    window.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
  }

  const savedLang = getCurrentLang();
  setLang(savedLang);

  langToggle?.addEventListener('click', () => {
    const currentLang = getCurrentLang();
    const newLang = currentLang === 'en' ? 'zh' : 'en';
    setLang(newLang);
  });
</script>
