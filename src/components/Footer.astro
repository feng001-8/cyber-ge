<footer class="mt-32 w-full border-t border-text-main/5 pt-12 pb-8 transition-opacity duration-500 relative overflow-hidden">
  <div class="absolute bottom-0 left-0 w-full h-1 bg-jade/10">
    <div class="h-full w-full bg-jade/30 animate-ripple origin-left"></div>
  </div>
  <div class="flex flex-col md:flex-row justify-between items-center gap-8 relative z-10 max-w-7xl mx-auto px-6">
    <div class="flex items-center gap-6">
      <div class="text-text-main font-display font-bold text-lg tracking-tight">Cyber-GE</div>
      <div class="flex items-center gap-3 px-4 py-2 bg-white/50 border border-black/5 rounded-full backdrop-blur-sm" title="Eth Gas: 24 gwei">
        <div class="relative w-5 h-5">
          <div class="absolute inset-0 rounded-full bg-jade opacity-20 animate-pulse-slow"></div>
          <div class="relative w-full h-full rounded-full border border-text-subtle overflow-hidden animate-spin-slow">
            <div class="absolute inset-0 bg-gradient-to-b from-white via-transparent to-black opacity-60"></div>
            <div class="absolute top-1/2 left-1/2 w-[3px] h-[3px] bg-black rounded-full -translate-x-1/2 -translate-y-[5px]"></div>
            <div class="absolute top-1/2 left-1/2 w-[3px] h-[3px] bg-white rounded-full -translate-x-1/2 translate-y-[3px]"></div>
          </div>
        </div>
        <span class="text-[10px] font-mono text-jade font-bold tracking-widest">BLOCK: 18452021</span>
      </div>
    </div>
    <div class="flex gap-8">
      <a href="https://github.com" target="_blank" rel="noopener" class="text-text-subtle hover:text-jade transition-colors transform hover:-translate-y-1 duration-300">
        <span class="sr-only">GitHub</span>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
