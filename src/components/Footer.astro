        </svg>
      </a>
      <a href="https://twitter.com" target="_blank" rel="noopener" class="text-text-subtle hover:text-jade transition-colors transform hover:-translate-y-1 duration-300">
        <span class="sr-only">Twitter</span>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
        </svg>
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener" class="text-text-subtle hover:text-jade transition-colors transform hover:-translate-y-1 duration-300">
        <span class="sr-only">LinkedIn</span>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
        </svg>
      </a>
    </div>
    <div class="text-xs text-text-subtle font-mono opacity-60">
      <span class="i18n" data-en="© 2024 // All Systems Operational" data-zh="© 2024 // 系统运行正常">© 2024 // All Systems Operational</span>
    </div>
  </div>
</footer>

<script>
  function updateFooterI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('footer .i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateFooterI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateFooterI18n(customEvent.detail.lang);
  });
</script>
