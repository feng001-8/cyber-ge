---
interface Props {
  title: string;
  description: string;
  date: string;
  lunarDate?: string;
  tags: string[];
  codeSnippet?: string;
  slug: string;
}

const { title, description, date, lunarDate, tags, codeSnippet, slug } = Astro.props;
const [day, month, year] = date.split(' ');
---

<article class="scroll-card group relative bg-white/40 backdrop-blur-sm border border-[#E5E7EB] hover:border-jade p-8 rounded-sm shadow-sm">
  <a href={`/blog/${slug}`} class="absolute inset-0 z-10"></a>
  <div class="flex flex-col md:flex-row gap-8">
    <div class="md:w-1/4 flex flex-row md:flex-col justify-between md:justify-start gap-2 border-b md:border-b-0 md:border-r border-dashed border-text-main/10 pb-6 md:pb-0 md:pr-8 shrink-0">
      <span class="font-mono text-3xl font-bold text-text-main">{day}</span>
      <div class="flex flex-col text-xs text-text-subtle font-mono">
        <span class="uppercase tracking-wide">{month} {year}</span>
        {lunarDate && <span class="text-jade mt-2 italic opacity-80">{lunarDate}</span>}
      </div>
    </div>
    <div class="flex flex-col gap-4 md:w-3/4">
      <div class="flex items-center gap-3 mb-1 flex-wrap">
        {tags.map((tag) => (
          <span class="bg-gray-100/80 text-gray-600 text-[10px] uppercase font-bold px-2 py-1 rounded font-mono tracking-wider">{tag}</span>
        ))}
      </div>
      <h3 class="font-display text-2xl font-bold text-text-main group-hover:text-jade transition-colors cursor-pointer leading-tight">
        {title}
      </h3>
      <p class="text-text-subtle text-base leading-relaxed font-light">
        {description}
      </p>
      {codeSnippet && (
        <div class="bg-gray-50 p-4 rounded-sm border-l-2 border-jade/30 font-mono text-xs overflow-x-auto">
          <Fragment set:html={codeSnippet} />
        </div>
      )}
      <div class="mt-4 flex items-center justify-end">
        <span class="i18n text-xs font-bold uppercase tracking-widest text-text-main group-hover:text-jade flex items-center gap-2 transition-colors relative z-20" data-en="Read Scroll" data-zh="阅读全文">
          Read Scroll
          <span class="material-symbols-outlined text-base">arrow_right_alt</span>
        </span>
      </div>
    </div>
  </div>
</article>

<script>
  function updateCardI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.scroll-card .i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        const icon = htmlEl.querySelector('.material-symbols-outlined');
        htmlEl.textContent = text + ' ';
        if (icon) htmlEl.appendChild(icon);
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateCardI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateCardI18n(customEvent.detail.lang);
  });
</script>
