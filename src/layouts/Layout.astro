---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OracleButton from '../components/OracleButton.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const { title, description = 'Cyber-GE: Harmonizing Silicon & Spirit', currentPage = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Cyber-GE</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&family=Noto+Serif+SC:wght@300;400;700;900&family=JetBrains+Mono:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <!-- KaTeX for math rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous" />
  <style>
    /* Critical CSS for above-the-fold content */
    body { opacity: 0; animation: bodyFadeIn 0.3s ease forwards; }
    @keyframes bodyFadeIn { to { opacity: 1; } }
  </style>
</head>
<body class="bg-background-light text-text-main font-body min-h-screen flex flex-col relative overflow-x-hidden bg-rice-paper">
  <div class="circuit-overlay"></div>
  <div class="taiji-watermark"></div>
  
  <Header currentPage={currentPage} />
  
  <slot />
  
  <Footer />
  <OracleButton />
  
  <script>
    // Global i18n helper - runs once on page load
    const initI18n = () => {
      const lang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
      document.body.classList.add(`lang-${lang}`);
      document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
    };
    initI18n();
  </script>
</body>
</html>
