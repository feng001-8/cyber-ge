---
import Layout from '../../layouts/Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: string;
    tags: string[];
    hexagram?: string;
    element?: string;
  };
}

const { frontmatter } = Astro.props;
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={frontmatter.title} description={frontmatter.description} currentPage="blog">
  <article class="w-full max-w-3xl">
    <!-- Header -->
    <header class="mb-12 border-b border-text-main/10 pb-8">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        {frontmatter.tags.map((tag) => (
          <span class="bg-jade/10 text-jade text-xs uppercase font-bold px-3 py-1 rounded-full font-mono tracking-wider">{tag}</span>
        ))}
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-text-main leading-tight mb-4">
        {frontmatter.title}
      </h1>
      <p class="text-text-subtle text-lg font-light mb-6">
        {frontmatter.description}
      </p>
      <div class="flex items-center gap-4 text-sm font-mono text-text-subtle">
        <time datetime={frontmatter.pubDate}>{formattedDate}</time>
        {frontmatter.hexagram && (
          <>
            <span class="w-1 h-1 rounded-full bg-text-subtle/30"></span>
            <span class="font-display text-lg">{frontmatter.hexagram}</span>
          </>
        )}
      </div>
    </header>
    
    <!-- Content -->
    <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-text-main prose-p:text-text-main prose-p:leading-relaxed prose-a:text-jade prose-a:no-underline hover:prose-a:underline prose-code:text-jade prose-code:bg-jade/5 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-xuan-bg prose-pre:text-xuan-fg">
      <slot />
    </div>
    
    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-dashed border-text-main/10">
      <div class="flex items-center justify-between">
        <a href="/blog" class="flex items-center gap-2 font-mono text-sm text-text-subtle hover:text-jade transition-colors">
          <span class="material-symbols-outlined text-lg">arrow_back</span>
          Back to Archive
        </a>
        <div class="flex items-center gap-4">
          <span class="font-mono text-xs text-text-subtle">Share:</span>
          <a href="#" class="text-text-subtle hover:text-jade transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </a>
        </div>
      </div>
    </footer>
  </article>
</Layout>
