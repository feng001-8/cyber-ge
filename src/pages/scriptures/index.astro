---
import Layout from '../../layouts/Layout.astro';

const scriptures = [
  {
    id: 'smart-contracts',
    symbol: '☰',
    trigram: 'Solidity',
    trigramZh: 'Solidity',
    element: 'Smart Contracts',
    elementZh: '智能合约',
    title: 'Solidity 智能合约开发',
    titleEn: 'Solidity Smart Contract Development',
    status: 'completed',
    statusZh: '已完成',
    chapters: 8,
    tags: ['Solidity', 'EVM', 'Security', 'DeFi'],
    description: 'A comprehensive guide to Solidity smart contract development. From blockchain fundamentals to advanced patterns like proxy upgrades, covering security best practices, gas optimization, and token standards.',
    descriptionZh: '完整的 Solidity 智能合约开发指南。从区块链基础到代理升级等高级模式，涵盖安全最佳实践、Gas 优化和代币标准。'
  },
  {
    id: 'spoken-english',
    symbol: '䷹',
    trigram: 'Dui',
    trigramZh: '兑',
    element: 'Lake',
    elementZh: '泽',
    title: '英语口语',
    titleEn: 'Spoken English',
    status: 'drafting',
    statusZh: '撰写中',
    chapters: 3,
    tags: ['English', 'Speaking', 'Daily Life'],
    description: 'Notes and reflections on practicing spoken English for various daily scenarios like shopping, airports, and asking for directions.',
    descriptionZh: '针对购物、机场乘机、问路等日常场景的英语口语复习笔记与心得体会。'
  },
  {
    id: 'go-concurrency',
    symbol: '䷜',
    trigram: 'Kan',
    trigramZh: '坎',
    element: 'Water',
    elementZh: '水',
    title: '并发心流',
    titleEn: 'Flow State Concurrency',
    status: 'drafting',
    statusZh: '撰写中',
    chapters: 3,
    tags: ['Golang', 'CSP', 'Channels'],
    description: 'Like water, Go routines flow through the channels of the processor. This manuscript investigates the philosophy of Communicating Sequential Processes (CSP) and argues that modern distributed systems should mimic organic neural networks.',
    descriptionZh: '如水一般，Go 协程流经处理器的通道。本手稿探讨通信顺序进程（CSP）的哲学，主张现代分布式系统应模仿有机神经网络。'
  },
  {
    id: 'machine-spirit',
    symbol: '䷲',
    trigram: 'Zhen',
    trigramZh: '震',
    element: 'Thunder',
    elementZh: '雷',
    title: '灵机一动',
    titleEn: 'The Spark of Machine Spirit',
    status: 'new',
    statusZh: '新篇',
    chapters: 1,
    tags: ['AI', 'LLM', 'Agents'],
    description: 'Can silicon dream? This collection of essays documents experiments in Agentic AI workflows. It explores the blurred line between prompt engineering and prayer, looking at how Large Language Models hallucinate new realities.',
    descriptionZh: '硅基能否做梦？本文集记录了智能体 AI 工作流的实验。探索提示工程与祈祷之间的模糊界限，观察大语言模型如何幻化新的现实。'
  },
  {
    id: 'zero-knowledge',
    symbol: '䷁',
    trigram: 'Kun',
    trigramZh: '坤',
    element: 'Earth',
    elementZh: '地',
    title: '零知秘典',
    titleEn: 'The Zero Knowledge Codex',
    status: 'planned',
    statusZh: '筹备中',
    chapters: 0,
    tags: ['ZK-SNARKs', 'Privacy', 'Cryptography'],
    description: 'Proving without revealing—the ultimate paradox of trust. This upcoming volume will explore the mathematical foundations of zero-knowledge proofs and their applications in privacy-preserving computation.',
    descriptionZh: '证明而不揭示——信任的终极悖论。本卷将探索零知识证明的数学基础及其在隐私保护计算中的应用。'
  }
];

const statusColors: Record<string, { border: string; text: string; bg: string }> = {
  completed: { border: 'border-jade', text: 'text-jade', bg: 'bg-jade/5' },
  drafting: { border: 'border-amber-500', text: 'text-amber-600', bg: 'bg-amber-50' },
  new: { border: 'border-jade', text: 'text-jade', bg: 'bg-jade/5' },
  planned: { border: 'border-text-subtle', text: 'text-text-subtle', bg: 'bg-text-main/5' }
};
---

<Layout title="藏经 · Scriptures | Cyber-GE">
  <main class="relative z-10 flex-grow w-full max-w-5xl mx-auto px-6 py-10">
    
    <!-- Page Header -->
    <section class="w-full mb-8">
      <span class="font-mono text-jade text-xs tracking-widest uppercase mb-2 block">The Scripture Pavilion</span>
      <h1 class="font-display text-4xl md:text-5xl font-black text-text-main tracking-tight mb-1">藏经阁</h1>
      <p class="i18n font-display text-base text-text-subtle italic" data-en="Where Code Meets the Tao" data-zh="代码与道的交汇之处">Where Code Meets the Tao</p>
    </section>

    <!-- Quote Section -->
    <section class="w-full max-w-lg mb-8">
      <div class="relative py-2 px-3 border-l-2 border-jade/30">
        <p class="font-display text-sm leading-relaxed text-text-main/70 italic">
          "The Tao that can be told is not the eternal Tao."
        </p>
        <div class="mt-1 text-[10px] font-mono text-text-subtle">— 道德经 · Chapter 1</div>
      </div>
    </section>

    <!-- Scripture Cards -->
    <div class="w-full space-y-5">
      {scriptures.map((scripture, idx) => (
        <article 
          class="scripture-card group relative w-full bg-white/60 backdrop-blur-sm border border-text-main/10 rounded-sm overflow-hidden transition-all duration-500 hover:shadow-jade-glow hover:border-jade/50 opacity-0 translate-y-4"
          style={`--delay: ${idx * 0.1}s;`}
        >
          <div class="flex flex-col md:flex-row h-full">
            <!-- Book Spine / Cover -->
            <div class="w-full md:w-40 h-40 md:h-auto bg-ink flex items-center justify-center relative shrink-0 min-h-[160px]">
              <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/black-linen.png')]"></div>
              <div class="relative z-10 flex flex-col items-center gap-2">
                <span class="text-white/90 text-4xl font-mono">{scripture.symbol}</span>
                <span class="i18n text-jade text-[9px] font-mono tracking-widest uppercase" data-en={`${scripture.trigram} • ${scripture.element}`} data-zh={`${scripture.trigramZh} • ${scripture.elementZh}`}>
                  {scripture.trigram} • {scripture.element}
                </span>
              </div>
              <div class="absolute bottom-2 left-2 w-6 h-[1px] bg-jade/50"></div>
              <div class="absolute top-2 right-2 w-6 h-[1px] bg-jade/50"></div>
            </div>

            <!-- Content -->
            <div class="flex-1 p-5 md:p-6 flex flex-col justify-between relative">
              <div>
                <!-- Tags -->
                <div class="flex flex-wrap items-center gap-1.5 mb-2">
                  <span class={`px-1.5 py-0.5 text-[9px] font-mono border ${statusColors[scripture.status].border} ${statusColors[scripture.status].text} uppercase rounded-sm`}>
                    <span class="i18n" data-en={scripture.status} data-zh={scripture.statusZh}>{scripture.status}</span>
                  </span>
                  <span class="px-1.5 py-0.5 text-[9px] font-mono bg-text-main/5 text-text-subtle uppercase rounded-sm">
                    <span class="i18n" data-en={`${scripture.chapters} Chapters`} data-zh={`${scripture.chapters} 章`}>{scripture.chapters} Chapters</span>
                  </span>
                  {scripture.tags.map(tag => (
                    <span class="px-1.5 py-0.5 text-[9px] font-mono bg-text-main/5 text-text-subtle uppercase rounded-sm">{tag}</span>
                  ))}
                </div>

                <!-- Title -->
                <h2 class="font-display text-lg md:text-xl font-bold text-text-main mb-0.5 group-hover:text-jade transition-colors">
                  {scripture.title}
                </h2>
                <h3 class="font-mono text-[9px] uppercase tracking-widest text-text-subtle mb-2">
                  {scripture.titleEn}
                </h3>

                <!-- Description -->
                <p class="i18n font-body text-text-subtle text-sm leading-relaxed max-w-xl line-clamp-2" data-en={scripture.description} data-zh={scripture.descriptionZh}>
                  {scripture.description}
                </p>
              </div>

              <!-- CTA Button -->
              <div class="mt-4 md:mt-0 md:absolute md:bottom-6 md:right-6 md:opacity-0 md:group-hover:opacity-100 transition-all duration-500 md:transform md:translate-x-4 md:group-hover:translate-x-0">
                <a 
                  href={scripture.status !== 'planned' ? `/scriptures/${scripture.id}/01` : '#'}
                  class={`inline-flex items-center gap-1.5 px-4 py-2 rounded-sm shadow-sm transition-colors text-sm ${scripture.status === 'planned' ? 'bg-text-main/10 text-text-subtle cursor-not-allowed' : 'bg-jade text-white hover:bg-jade/90'}`}
                >
                  <span class="i18n font-display" data-en="Open" data-zh="开卷">开卷</span>
                  <span class="i18n text-[10px] uppercase tracking-wide font-mono" data-en="Open Scroll" data-zh="阅读">Open Scroll</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <style>
    .scripture-card {
      will-change: transform, opacity;
      transition: opacity 0.6s ease, transform 0.6s ease, box-shadow 0.5s ease, border-color 0.5s ease;
      transition-delay: var(--delay);
    }

    .scripture-card.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script>
    const cards = document.querySelectorAll('.scripture-card');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    cards.forEach(card => observer.observe(card));

    // i18n support
    function updateI18n(lang: 'en' | 'zh') {
      document.querySelectorAll('.i18n').forEach(el => {
        const htmlEl = el as HTMLElement;
        const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
        if (text) {
          htmlEl.textContent = text;
        }
      });
    }

    const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
    updateI18n(savedLang);

    window.addEventListener('langchange', (e: Event) => {
      const customEvent = e as CustomEvent;
      updateI18n(customEvent.detail.lang);
    });
  </script>
</Layout>
