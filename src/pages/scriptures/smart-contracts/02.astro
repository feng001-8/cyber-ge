---
import Layout from '../../../layouts/Layout.astro';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';

// 读取 Markdown 文件
const mdPath = path.join(process.cwd(), 'src/content/scriptures/smart-contracts/02-solidity-basics.md');
const mdContent = fs.readFileSync(mdPath, 'utf-8');
let htmlContent = marked(mdContent);

// 修复代码块第一行空白问题
htmlContent = htmlContent.replace(/<code([^>]*)>\n/g, '<code$1>');

const scripture = {
  symbol: '☰',
  title: 'Solidity 智能合约开发',
  titleEn: 'Solidity Smart Contract Development',
  chapters: [
    { id: 'blockchain-fundamentals', volume: 1, title: 'Blockchain Fundamentals', titleZh: '区块链与以太坊基础' },
    { id: 'solidity-basics', volume: 2, title: 'Solidity Basics', titleZh: 'Solidity 语言基础' },
    { id: 'storage-and-gas', volume: 3, title: 'Storage and Gas', titleZh: '数据存储与 Gas 优化' },
    { id: 'interaction-and-inheritance', volume: 4, title: 'Interaction and Inheritance', titleZh: '合约交互与继承' },
    { id: 'security', volume: 5, title: 'Security', titleZh: '安全与常见漏洞' },
    { id: 'token-standards', volume: 6, title: 'Token Standards', titleZh: '代币标准' },
    { id: 'upgrade-patterns', volume: 7, title: 'Upgrade Patterns', titleZh: '升级模式' },
    { id: 'testing-and-deployment', volume: 8, title: 'Testing and Deployment', titleZh: '测试与部署' },
  ]
};

const chapter = scripture.chapters[1];
const prevChapter = scripture.chapters[0];
const nextChapter = scripture.chapters[2];
const readTime = 25;
---

<Layout title={`${chapter.titleZh} · ${scripture.title}`}>
  <main class="relative z-10 flex-grow w-full max-w-[1600px] mx-auto flex flex-col lg:flex-row min-h-[calc(100vh-4rem)]">
    <!-- Sidebar -->
    <aside class="w-full lg:w-72 border-b lg:border-b-0 lg:border-r border-text-main/10 flex-shrink-0 bg-[#FAFAF8] lg:sticky lg:top-16 lg:h-[calc(100vh-4rem)] overflow-y-auto hidden lg:block">
      <div class="p-5 sticky top-0 bg-[#FAFAF8]/95 backdrop-blur-sm z-10 border-b border-text-main/5">
        <a href="/scriptures" class="flex items-center gap-2 text-text-subtle hover:text-jade transition-colors mb-3 text-sm">
          <span class="material-symbols-outlined text-base">arrow_back</span>
          <span>返回书架</span>
        </a>
        <h2 class="font-bold text-lg text-text-main leading-tight">{scripture.title}</h2>
        <p class="text-xs text-text-subtle mt-1">{scripture.titleEn}</p>
      </div>
      <nav class="p-3 space-y-1">
        {scripture.chapters.map((ch, idx) => {
          const isActive = idx === 1;
          return (
            <a href={`/scriptures/smart-contracts/${String(ch.volume).padStart(2, '0')}`} class={`group relative block px-4 py-3 rounded-lg transition-all duration-200 ${isActive ? 'bg-jade/10' : 'hover:bg-black/5'}`}>
              <div class={`absolute left-0 top-2 bottom-2 w-1 rounded-full transition-all ${isActive ? 'bg-jade' : 'bg-transparent group-hover:bg-jade/30'}`}></div>
              <div class="flex items-start gap-3">
                <span class={`font-mono text-xs mt-0.5 ${isActive ? 'text-jade font-bold' : 'text-text-subtle'}`}>{String(ch.volume).padStart(2, '0')}</span>
                <div>
                  <div class={`text-sm leading-tight ${isActive ? 'font-bold text-jade' : 'text-text-main'}`}>{ch.titleZh}</div>
                  <div class="text-xs text-text-subtle mt-0.5">{ch.title}</div>
                </div>
              </div>
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- Main Content -->
    <div class="flex-grow overflow-y-auto">
      <article class="max-w-4xl mx-auto px-6 py-8 lg:py-12">
        <header class="mb-10 pb-8 border-b border-text-main/10">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-mono text-sm text-jade font-bold">第 {chapter.volume} 章</span>
            <span class="text-text-subtle">·</span>
            <span class="text-sm text-text-subtle">约 {readTime} 分钟阅读</span>
          </div>
          <h1 class="text-3xl lg:text-4xl font-bold text-text-main mb-2">{chapter.titleZh}</h1>
          <p class="text-lg text-text-subtle">{chapter.title}</p>
        </header>

        <div class="prose prose-lg max-w-none scripture-content" set:html={htmlContent}>
        </div>

        <!-- Navigation -->
        <nav class="mt-16 pt-8 border-t border-text-main/10 flex justify-between items-center">
          {prevChapter ? (
            <a href={`/scriptures/smart-contracts/${String(prevChapter.volume).padStart(2, '0')}`} class="group flex items-center gap-3 text-text-subtle hover:text-jade transition-colors">
              <span class="material-symbols-outlined">arrow_back</span>
              <div>
                <div class="text-xs">上一章</div>
                <div class="font-medium text-text-main group-hover:text-jade">{prevChapter.titleZh}</div>
              </div>
            </a>
          ) : <div></div>}
          {nextChapter ? (
            <a href={`/scriptures/smart-contracts/${String(nextChapter.volume).padStart(2, '0')}`} class="group flex items-center gap-3 text-text-subtle hover:text-jade transition-colors text-right">
              <div>
                <div class="text-xs">下一章</div>
                <div class="font-medium text-text-main group-hover:text-jade">{nextChapter.titleZh}</div>
              </div>
              <span class="material-symbols-outlined">arrow_forward</span>
            </a>
          ) : <div></div>}
        </nav>
      </article>
    </div>
  </main>
</Layout>

<style is:global>
  .scripture-content h1 { display: none; }
  .scripture-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(42, 45, 44, 0.1);
  }
  .scripture-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .scripture-content h4 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .scripture-content p {
    color: var(--color-text-main);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .scripture-content ul, .scripture-content ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .scripture-content li {
    margin-bottom: 0.5rem;
    color: var(--color-text-main);
  }
  .scripture-content blockquote {
    border-left: 4px solid var(--color-jade);
    background-color: rgba(74, 139, 113, 0.05);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .scripture-content blockquote p {
    margin-bottom: 0;
  }
  .scripture-content code {
    background-color: #f3f4f6;
    color: #1f2937;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, monospace;
  }
  .scripture-content .code-block-wrapper {
    position: relative;
    margin: 1.5rem 0;
  }
  .scripture-content .code-block-wrapper .code-toolbar {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.25rem;
    z-index: 10;
  }
  .scripture-content .code-block-wrapper .code-toolbar button {
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #e5e7eb;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .scripture-content .code-block-wrapper .code-toolbar button:hover {
    background: #fff;
    color: #374151;
    border-color: #d1d5db;
  }
  .scripture-content .code-block-wrapper .code-toolbar button.copied {
    background: var(--color-jade);
    color: white;
    border-color: var(--color-jade);
  }
  .scripture-content pre {
    background-color: #f9fafb;
    color: #1f2937;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 0;
    border: 1px solid #e5e7eb;
    transition: max-height 0.3s ease;
  }
  .scripture-content pre.collapsed {
    max-height: 80px;
    overflow: hidden;
    position: relative;
  }
  .scripture-content pre.collapsed::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40px;
    background: linear-gradient(transparent, #f9fafb);
    pointer-events: none;
  }
  .scripture-content pre code {
    background-color: transparent;
    padding: 0;
    font-size: 0.875rem;
  }
  .scripture-content table {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
  }
  .scripture-content th {
    background-color: #f9fafb;
    text-align: left;
    padding: 0.5rem 1rem;
    border: 1px solid #e5e7eb;
    font-weight: 600;
    font-size: 0.875rem;
  }
  .scripture-content td {
    padding: 0.5rem 1rem;
    border: 1px solid #e5e7eb;
    font-size: 0.875rem;
  }
  .scripture-content img {
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
    margin: 1.5rem 0;
    max-width: 100%;
    cursor: zoom-in;
  }
  .scripture-content img.zoomed {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 90vw;
    max-height: 90vh;
    z-index: 1000;
    cursor: zoom-out;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
  .image-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 999;
    display: none;
  }
  .image-overlay.active {
    display: block;
  }
  .scripture-content hr {
    margin: 2.5rem 0;
    border-color: rgba(42, 45, 44, 0.1);
  }
  .scripture-content a {
    color: var(--color-jade);
  }
  .scripture-content a:hover {
    text-decoration: underline;
  }
</style>

<div id="image-overlay" class="image-overlay"></div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const overlay = document.getElementById('image-overlay');
  
  // 为所有代码块添加工具栏
  const preElements = document.querySelectorAll('.scripture-content pre');
  preElements.forEach(pre => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);
    
    const toolbar = document.createElement('div');
    toolbar.className = 'code-toolbar';
    
    // 复制按钮
    const copyBtn = document.createElement('button');
    copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 14px;">content_copy</span> 复制';
    copyBtn.onclick = async (e) => {
      e.stopPropagation();
      const code = (pre.querySelector('code')?.textContent || pre.textContent).trim();
      await navigator.clipboard.writeText(code);
      copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 14px;">check</span> 已复制';
      copyBtn.classList.add('copied');
      setTimeout(() => {
        copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 14px;">content_copy</span> 复制';
        copyBtn.classList.remove('copied');
      }, 2000);
    };
    toolbar.appendChild(copyBtn);
    
    // 折叠/展开按钮（仅当代码超过 5 行时显示）
    const lineCount = (pre.textContent || '').split('\n').length;
    if (lineCount > 5) {
      pre.classList.add('collapsed');
      const toggleBtn = document.createElement('button');
      toggleBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 14px;">unfold_more</span> 展开';
      toggleBtn.onclick = (e) => {
        e.stopPropagation();
        pre.classList.toggle('collapsed');
        if (pre.classList.contains('collapsed')) {
          toggleBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 14px;">unfold_more</span> 展开';
        } else {
          toggleBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 14px;">unfold_less</span> 折叠';
        }
      };
      toolbar.appendChild(toggleBtn);
    }
    
    wrapper.insertBefore(toolbar, pre);
  });
  
  // 图片缩放功能
  const images = document.querySelectorAll('.scripture-content img');
  
  images.forEach(img => {
    img.addEventListener('click', () => {
      if (img.classList.contains('zoomed')) {
        img.classList.remove('zoomed');
        overlay.classList.remove('active');
      } else {
        img.classList.add('zoomed');
        overlay.classList.add('active');
      }
    });
  });
  
  // 点击遮罩关闭
  overlay.addEventListener('click', () => {
    const zoomedImg = document.querySelector('.scripture-content img.zoomed');
    if (zoomedImg) {
      zoomedImg.classList.remove('zoomed');
    }
    overlay.classList.remove('active');
  });
  
  // ESC 键关闭缩放
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const zoomedImg = document.querySelector('.scripture-content img.zoomed');
      if (zoomedImg) {
        zoomedImg.classList.remove('zoomed');
      }
      overlay.classList.remove('active');
    }
  });
});
</script>
