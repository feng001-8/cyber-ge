---
import Layout from '../layouts/Layout.astro';

const timeline = [
  { period: '2023 // Present', periodZh: '2023 // 至今', role: 'Architecting L2 ZK-Rollup Solutions', roleZh: '构建 L2 ZK-Rollup 解决方案' },
  { period: '2021 // 2023', periodZh: '2021 // 2023', role: 'Core Contributor to Go-Ethereum', roleZh: 'Go-Ethereum 核心贡献者' },
  { period: '2019 // 2021', periodZh: '2019 // 2021', role: 'Research on Byzantine Fault Tolerance', roleZh: '拜占庭容错研究' },
];

const links = [
  { icon: 'code_blocks', name: 'GitHub', href: 'https://github.com' },
  { icon: 'alternate_email', name: 'X / Twitter', href: 'https://twitter.com' },
];
---

<Layout title="坐忘 - About" description="Sitting in Oblivion" currentPage="about">
  <main class="relative z-10 flex-grow w-full max-w-3xl mx-auto px-6 py-10">
  <!-- Page Header -->
  <section class="w-full mb-6 text-center">
    <span class="font-mono text-jade text-xs tracking-widest uppercase mb-2 block">Zuò Wàng</span>
    <h1 class="font-display text-4xl md:text-5xl font-black text-text-main tracking-tight mb-1">坐忘</h1>
    <p class="i18n font-display text-base text-text-subtle italic" data-en='"Sitting in Oblivion"' data-zh='"坐忘于道"'>"Sitting in Oblivion"</p>
  </section>
  
  <!-- Mountain Illustration -->
  <div class="w-full max-w-[200px] mx-auto mb-10 opacity-80 mix-blend-multiply">
    <svg class="w-full h-auto stroke-text-main fill-none stroke-[0.8]" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg">
      <path d="M50 180 L150 50 L250 180"></path>
      <path d="M120 180 L200 80 L280 180" opacity="0.6"></path>
      <path d="M220 180 L300 100 L350 180" opacity="0.4"></path>
      <circle class="fill-jade/10 stroke-jade" cx="200" cy="40" r="15"></circle>
    </svg>
  </div>
  
  <!-- Bio -->
  <article class="prose prose-sm md:prose-base font-display text-text-main leading-relaxed text-justify w-full max-w-2xl mx-auto">
    <p class="i18n-bio-1 first-letter:text-5xl first-letter:float-left first-letter:mr-2 first-letter:text-jade first-letter:font-bold" data-en="In the digital void, structure emerges from chaos. I am a System Architect exploring the boundaries where rigorous logic meets fluid intuition. My journey began not with code, but with the I Ching—understanding that every state change is a transformation, every bit a duality of Yin and Yang." data-zh="在数字虚空中，结构从混沌中涌现。我是一名系统架构师，探索严谨逻辑与流动直觉交汇的边界。我的旅程并非始于代码，而是始于《易经》——理解每一次状态变化都是一次转化，每一个比特都是阴阳的二元。">
      In the digital void, structure emerges from chaos. I am a System Architect exploring the boundaries where rigorous logic meets fluid intuition. My journey began not with code, but with the I Ching—understanding that every state change is a transformation, every bit a duality of Yin and Yang.
    </p>
    <p class="i18n-bio-2" data-en='Specializing in <span class="text-jade font-medium">Go</span> and <span class="text-jade font-medium">Distributed Systems</span>, I build infrastructure that breathes. I believe software should possess the quality of water: adaptable, resilient, and capable of flowing around obstacles or eroding them over time.' data-zh='专注于 <span class="text-jade font-medium">Go</span> 和 <span class="text-jade font-medium">分布式系统</span>，我构建有生命力的基础设施。我相信软件应该具有水的品质：适应性强、韧性十足，能够绕过障碍或随时间侵蚀它们。'>
      Specializing in <span class="text-jade font-medium">Go</span> and <span class="text-jade font-medium">Distributed Systems</span>, I build infrastructure that breathes. I believe software should possess the quality of water: adaptable, resilient, and capable of flowing around obstacles or eroding them over time.
    </p>
    <p class="i18n-bio-3" data-en="Currently, my focus lies in the intersection of Web3 sovereignty and Artificial Intelligence. How do we imbue autonomous agents with ethical alignment? How do we design consensus mechanisms that mirror natural laws?" data-zh="目前，我专注于 Web3 主权与人工智能的交叉领域。我们如何赋予自主代理伦理对齐？我们如何设计反映自然法则的共识机制？">
      Currently, my focus lies in the intersection of Web3 sovereignty and Artificial Intelligence. How do we imbue autonomous agents with ethical alignment? How do we design consensus mechanisms that mirror natural laws?
    </p>
  </article>
  
  <!-- Timeline -->
  <section class="w-full mt-10 border-t border-dashed border-text-main/20 pt-8 max-w-2xl mx-auto">
    <h3 class="i18n font-mono text-[10px] uppercase tracking-widest text-text-subtle mb-5 text-center" data-en="Path of Cultivation" data-zh="修行之路">Path of Cultivation</h3>
    <div class="space-y-3 font-mono text-sm">
      {timeline.map((item) => (
        <div class="flex flex-col md:flex-row md:items-baseline justify-between group">
          <span class="i18n text-jade font-bold mr-4 shrink-0" data-en={item.period} data-zh={item.periodZh}>{item.period}</span>
          <span class="i18n text-text-main border-b border-transparent group-hover:border-jade transition-all" data-en={item.role} data-zh={item.roleZh}>{item.role}</span>
        </div>
      ))}
    </div>
  </section>
  
  <!-- Connect -->
  <section class="w-full mt-10 flex flex-col items-center max-w-2xl mx-auto">
    <div class="w-1 h-6 bg-text-main/10 mb-4"></div>
    <h3 class="i18n font-display text-lg font-bold mb-4" data-en="Connect Signal" data-zh="联系方式">Connect Signal</h3>
    <ul class="flex flex-col gap-2 w-full max-w-xs">
      {links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener" class="flex items-center justify-between p-3 border border-text-main/10 hover:border-jade hover:bg-white transition-all group rounded-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-text-subtle group-hover:text-jade text-lg">{link.icon}</span>
              <span class="font-mono text-sm font-bold text-text-main">{link.name}</span>
            </div>
            <span class="material-symbols-outlined text-xs text-text-subtle group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </li>
      ))}
      <li>
        <button 
          class="w-full flex items-center justify-between p-3 border border-text-main/10 hover:border-jade hover:bg-white transition-all group rounded-sm text-left"
          onclick="navigator.clipboard.writeText('0x71C...9A23'); this.querySelector('.copy-text').textContent = 'Copied!';"
        >
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-text-subtle group-hover:text-jade text-lg">wallet</span>
            <div class="flex flex-col">
              <span class="font-mono text-sm font-bold text-text-main">Ethereum</span>
              <span class="font-mono text-[9px] text-text-subtle">0x71C...9A23</span>
            </div>
          </div>
          <span class="material-symbols-outlined text-xs text-text-subtle group-hover:text-jade copy-text">content_copy</span>
        </button>
      </li>
    </ul>
  </section>
  </main>
</Layout>

<script>
  function updateI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
    
    document.querySelectorAll('.i18n-bio-1, .i18n-bio-2, .i18n-bio-3').forEach(el => {
      const htmlEl = el as HTMLElement;
      const html = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (html) {
        htmlEl.innerHTML = html;
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateI18n(customEvent.detail.lang);
  });
</script>
