---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const recentPosts = [
  {
    title: 'Building Decentralized Oracles',
    description: 'Exploring the intersection of smart contracts and real-world data feeds using Go.',
    date: '27 Oct 2023',
    lunarDate: 'Gui-Mao Year\n9th Month',
    tags: ['Smart Contracts', 'Go'],
    codeSnippet: `<span class="code-snippet"><span class="code-keyword">type</span> <span class="code-func">Oracle</span> <span class="code-keyword">struct</span> {<br/>  Feed <span class="code-keyword">chan</span> <span class="code-func">DataPoint</span><br/>  mu   <span class="code-func">sync.RWMutex</span><br/>}</span>`,
    slug: 'building-decentralized-oracles'
  },
  {
    title: 'AI Ethics & The Tao',
    description: 'Reflections on alignment problems through the lens of Eastern philosophy. Can the concept of \'Wu Wei\' (non-action) be applied to autonomous agents?',
    date: '15 Sep 2023',
    lunarDate: 'Gui-Mao Year\n8th Month',
    tags: ['Philosophy', 'AI Alignment'],
    slug: 'ai-ethics-and-the-tao'
  },
  {
    title: 'Concurrency Patterns in the Wild',
    description: 'Practical application of Go routines and channels in high-load distributed systems. Moving beyond the textbook examples.',
    date: '02 Aug 2023',
    lunarDate: 'Gui-Mao Year\n7th Month',
    tags: ['System Design'],
    codeSnippet: `<span class="code-snippet"><span class="code-keyword">go</span> <span class="code-keyword">func</span>() {<br/>  <span class="code-keyword">for</span> msg := <span class="code-keyword">range</span> ch {<br/>    process(msg) <span class="code-comment">// async flow</span><br/>  }<br/>}()</span>`,
    slug: 'concurrency-patterns-in-the-wild'
  }
];
---

<Layout title="Home" currentPage="home">
  <main class="relative z-10 flex-grow flex flex-col items-center w-full max-w-7xl mx-auto px-6 py-16 md:py-24">
  <!-- Zen Mode Toggle (Incense Icon) -->
  <button id="home-zen-toggle" class="fixed top-20 right-6 z-50 flex flex-col items-center gap-1 p-2 rounded-lg hover:bg-jade/5 transition-all group" title="Enter Zen Mode">
    <div class="incense-icon relative">
      <div class="w-0.5 h-8 bg-gradient-to-t from-cinnabar via-cinnabar/60 to-transparent rounded-full"></div>
      <div class="smoke absolute -top-2 left-1/2 -translate-x-1/2 w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity">
        <div class="smoke-particle"></div>
        <div class="smoke-particle" style="animation-delay: 0.3s;"></div>
      </div>
    </div>
    <span class="i18n text-[8px] font-mono text-text-subtle group-hover:text-jade uppercase tracking-wider" data-en="Zen" data-zh="禅">Zen</span>
  </button>

  <!-- Hero Section -->
  <section class="w-full grid grid-cols-1 md:grid-cols-2 gap-16 items-center min-h-[70vh] mb-32 zen-content">
    <div class="flex justify-center md:justify-end pr-0 md:pr-16 relative order-2 md:order-1">
      <div class="relative hero-text-container group cursor-default p-8">
        <!-- Main Chinese Text with Hex Reveal -->
        <div class="hero-text-wrapper relative">
          <h2 class="hero-main-text vertical-text font-display font-black text-8xl md:text-9xl text-text-main tracking-widest leading-none select-none opacity-90 transition-all duration-700 animate-float">
            道生一
          </h2>
          <!-- Hex Code Overlay (appears on hover) -->
          <div class="hero-hex-overlay vertical-text absolute inset-0 font-mono text-4xl md:text-5xl text-jade/80 tracking-widest leading-none select-none opacity-0 transition-all duration-500 flex flex-col justify-center items-center gap-2 pointer-events-none">
            <span>0x9053</span>
            <span>0x751F</span>
            <span>0x4E00</span>
          </div>
        </div>
        <div class="hero-binary-reveal absolute -right-4 top-0 h-full flex flex-col justify-center gap-6 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500">
          <span class="font-mono text-[10px] text-jade/60 tracking-widest vertical-text">01000100 01100001 01101111</span>
          <span class="font-mono text-[10px] text-jade/60 tracking-widest vertical-text">0x8D77 0x751F 0x4E00</span>
        </div>
        <div class="absolute -right-0 top-[10%] h-[80%] w-[1px] bg-gradient-to-b from-transparent via-jade/30 to-transparent hidden md:block transition-all duration-1000 group-hover:via-jade/80 group-hover:h-[120%] group-hover:-top-[10%]"></div>
      </div>
    </div>
    
    <div class="flex flex-col gap-8 md:pl-8 text-center md:text-left order-1 md:order-2">
      <div class="inline-block">
        <span class="i18n bg-jade/5 text-jade px-4 py-1.5 rounded-full text-xs font-mono font-medium tracking-widest uppercase mb-6 inline-block border border-jade/10" data-en="Available for hire" data-zh="可接受委托">
          Available for hire
        </span>
      </div>
      
      <div class="zk-gate cursor-help group relative">
        <h3 class="slogan-text font-display text-5xl md:text-6xl font-bold text-text-main leading-[1.15]">
          <span class="inline-block animate-fade-in-up" style="animation-delay: 0.1s;">Harmonizing</span><br/>
          <span class="inline-block animate-fade-in-up font-bold text-text-main" style="animation-delay: 0.3s;">Silicon</span>
          <span class="inline-block animate-fade-in-up font-light text-text-main/70 italic font-serif" style="animation-delay: 0.5s;">& Spirit</span>
        </h3>
        
        <!-- Hidden Wisdom (appears when mouse is still) -->
        <div id="hidden-wisdom" class="hidden-wisdom absolute -bottom-16 left-0 right-0 opacity-0 transition-all duration-500 pointer-events-none">
          <div class="wisdom-content bg-text-main/95 text-white p-4 rounded-lg shadow-xl">
            <p id="wisdom-text" class="font-display text-sm italic text-center"></p>
            <code id="wisdom-code" class="block mt-2 text-[10px] font-mono text-jade text-center"></code>
          </div>
        </div>
        
        <div class="wisdom-string">
          <span class="code-snippet">
            <span class="code-keyword">func</span> <span class="code-func">wu_wei</span>() {'{'} <span class="code-keyword">select</span> {'{'}{'}'}  {'}'} <span class="code-comment">// eternal pause</span>
          </span>
        </div>
      </div>
      
      <p class="i18n font-mono text-jade text-lg md:text-xl border-l-2 border-jade/40 pl-6 ml-0 md:ml-0 inline-block text-left py-1" data-en="System Architect // Web3 & AI" data-zh="系统架构师 // Web3 & AI">
        System Architect // Web3 & AI
      </p>
      
      <p class="i18n text-text-subtle max-w-lg text-lg leading-relaxed mt-4 mx-auto md:mx-0 font-light zen-text" data-en="Crafting decentralized architectures with the precision of Go and the adaptability of the Tao. Bridging the gap between rigid logic and fluid intelligence." data-zh="以 Go 的精准与道的适应性，构建去中心化架构。在刚性逻辑与流动智能之间架起桥梁。">
        Crafting decentralized architectures with the precision of Go and the adaptability of the Tao. Bridging the gap between rigid logic and fluid intelligence.
      </p>

      <!-- Pulse of the Tao -->
      <div class="pulse-container mt-6 flex items-center gap-4 zen-hide">
        <div id="taiji-pulse" class="taiji-pulse relative w-12 h-12 cursor-pointer" title="Synced with blockchain">
          <svg viewBox="0 0 100 100" class="w-full h-full animate-spin-slow">
            <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="1" class="text-text-main/10"/>
            <path d="M50 2 A48 48 0 0 1 50 98 A24 24 0 0 1 50 50 A24 24 0 0 0 50 2" fill="currentColor" class="text-text-main/80"/>
            <circle cx="50" cy="26" r="6" fill="currentColor" class="text-background-light"/>
            <circle cx="50" cy="74" r="6" fill="currentColor" class="text-text-main"/>
          </svg>
          <div class="pulse-ring absolute inset-0 rounded-full border border-jade/30 animate-pulse-ring"></div>
          <div class="pulse-ring absolute inset-0 rounded-full border border-jade/20 animate-pulse-ring" style="animation-delay: 0.5s;"></div>
          <!-- Block Pulse Effect -->
          <div id="block-pulse" class="block-pulse absolute inset-0 rounded-full border-2 border-jade opacity-0 scale-100"></div>
        </div>
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2">
            <span id="sync-indicator" class="w-2 h-2 rounded-full bg-jade animate-pulse"></span>
            <span class="i18n font-mono text-xs text-text-subtle" data-en="Network Pulse" data-zh="网络脉动">Network Pulse</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="gas-meter flex items-end gap-0.5 h-4">
              <div class="w-1 bg-jade/60 rounded-t animate-gas-bar" style="height: 40%;"></div>
              <div class="w-1 bg-jade/60 rounded-t animate-gas-bar" style="height: 70%; animation-delay: 0.1s;"></div>
              <div class="w-1 bg-jade/60 rounded-t animate-gas-bar" style="height: 50%; animation-delay: 0.2s;"></div>
              <div class="w-1 bg-jade/60 rounded-t animate-gas-bar" style="height: 90%; animation-delay: 0.3s;"></div>
              <div class="w-1 bg-jade/60 rounded-t animate-gas-bar" style="height: 30%; animation-delay: 0.4s;"></div>
            </div>
            <span class="font-mono text-[10px] text-jade" id="gas-price">~24 gwei</span>
            <span class="font-mono text-[10px] text-text-subtle/60">|</span>
            <span class="font-mono text-[10px] text-text-subtle" id="block-number">Block #19,847,231</span>
          </div>
        </div>
      </div>
      
      <div class="flex gap-6 mt-8 justify-center md:justify-start zen-hide">
        <a href="/projects" class="btn-primary bg-primary hover:bg-primary-dark text-white px-10 py-4 rounded-sm font-mono text-sm font-bold transition-all shadow-sm hover:shadow-lg flex items-center gap-3 group active:scale-[0.98]">
          <span class="i18n" data-en="Enter Portfolio" data-zh="进入作品集">Enter Portfolio</span>
          <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform duration-300">arrow_forward</span>
        </a>
        <a href="/blog" class="i18n link-underline border-b border-text-main/20 hover:border-jade hover:text-jade px-4 py-4 font-mono text-sm font-bold transition-all text-text-main active:scale-[0.98]" data-en="Read Writings" data-zh="阅读文章">
          Read Writings
        </a>
      </div>
    </div>
  </section>
  
  <div class="h-16 w-full"></div>
  
  <!-- Recent Scrolls Section -->
  <section class="w-full max-w-4xl flex flex-col gap-16 zen-content scroll-reveal">
    <div class="flex items-end justify-between border-b border-text-main/5 pb-6 zen-hide">
      <h4 class="font-display text-3xl font-bold text-text-main flex items-center gap-3">
        <span class="material-symbols-outlined text-jade text-3xl">history_edu</span>
        <span class="i18n" data-en="Recent Scrolls" data-zh="近期文章">Recent Scrolls</span>
      </h4>
      <a href="/blog" class="i18n link-underline text-sm font-mono text-text-subtle hover:text-jade transition-colors mb-1" data-en="View All Archive ->" data-zh="查看全部 ->">View All Archive -&gt;</a>
    </div>
    
    <div class="article-list-container space-y-8">
      {recentPosts.map((post, idx) => (
        <div class="article-ink-wrapper opacity-0 translate-y-4" style={`--delay: ${idx * 0.15}s;`}>
          <ArticleCard {...post} />
        </div>
      ))}
    </div>
  </section>
  </main>
</Layout>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @keyframes gas-bar {
    0%, 100% { height: var(--h, 50%); }
    50% { height: calc(var(--h, 50%) + 20%); }
  }

  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }

  .animate-pulse-ring {
    animation: pulse-ring 2s ease-out infinite;
  }

  .animate-gas-bar {
    animation: gas-bar 1.5s ease-in-out infinite;
  }

  .taiji-pulse:hover .animate-spin-slow {
    animation-duration: 5s;
  }

  .pulse-container {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out 1s forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Hero Text Hex Reveal */
  .hero-text-wrapper:hover .hero-main-text {
    opacity: 0.1;
    filter: blur(2px);
  }

  .hero-text-wrapper:hover .hero-hex-overlay {
    opacity: 1;
  }

  /* Smoke Animation */
  @keyframes smoke-rise {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0.5);
    }
    50% {
      opacity: 0.6;
    }
    100% {
      opacity: 0;
      transform: translateY(-20px) scale(1.5);
    }
  }

  .smoke-particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: radial-gradient(circle, rgba(74, 140, 114, 0.4) 0%, transparent 70%);
    border-radius: 50%;
    animation: smoke-rise 2s ease-out infinite;
  }

  /* Ink Spread Animation for Articles */
  @keyframes ink-spread-in {
    0% {
      opacity: 0;
      clip-path: circle(0% at 0% 50%);
    }
    100% {
      opacity: 1;
      clip-path: circle(150% at 0% 50%);
    }
  }

  .article-ink-wrapper {
    animation: ink-spread-in 0.8s ease-out forwards;
    animation-delay: var(--delay, 0s);
    opacity: 0;
  }

  /* Scroll-triggered ink effect */
  .article-ink-wrapper.ink-visible {
    animation: ink-spread-in 0.8s ease-out forwards;
  }

  /* Zen Mode Styles */
  body.home-zen-mode header,
  body.home-zen-mode footer,
  body.home-zen-mode .zen-hide,
  body.home-zen-mode #home-zen-toggle {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  body.home-zen-mode #home-zen-toggle {
    opacity: 0.2;
    pointer-events: auto;
  }

  body.home-zen-mode #home-zen-toggle:hover {
    opacity: 1;
  }

  body.home-zen-mode .zen-content {
    max-width: 800px;
    margin: 0 auto;
  }

  body.home-zen-mode .zen-text {
    font-size: 1.25rem;
    line-height: 2;
    letter-spacing: 0.02em;
  }

  body.home-zen-mode .article-list-container {
    gap: 4rem;
  }

  /* Incense glow effect */
  .incense-icon::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: var(--color-cinnabar);
    border-radius: 50%;
    box-shadow: 0 0 8px 2px rgba(179, 57, 57, 0.5);
    animation: glow-pulse 1.5s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  /* Hidden Wisdom (hover-still trigger) */
  .hidden-wisdom {
    z-index: 30;
  }

  .hidden-wisdom.visible {
    opacity: 1;
    transform: translateY(-5px);
  }

  .wisdom-content {
    backdrop-filter: blur(10px);
  }

  /* Block Pulse Animation */
  @keyframes block-pulse {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.5);
    }
  }

  .block-pulse.active {
    animation: block-pulse 0.8s ease-out forwards;
  }

  /* Taiji sync flash */
  .taiji-pulse.syncing svg {
    filter: drop-shadow(0 0 8px rgba(74, 140, 114, 0.8));
  }
</style>

<script>
  const gasPrices = ['~18 gwei', '~24 gwei', '~31 gwei', '~22 gwei', '~27 gwei'];
  const gasEl = document.getElementById('gas-price');
  const blockEl = document.getElementById('block-number');
  const zenToggle = document.getElementById('home-zen-toggle');
  const taijiPulse = document.getElementById('taiji-pulse');
  const blockPulse = document.getElementById('block-pulse');
  const syncIndicator = document.getElementById('sync-indicator');
  let blockNum = 19847231;

  // Wisdom quotes for hover-still trigger
  const wisdoms = [
    { text: '道可道，非常道', code: 'const Tao = undefined; // The Tao that can be defined is not the eternal Tao' },
    { text: '上善若水', code: 'func flow(path Path) { for { adapt(path) } }' },
    { text: '知者不言，言者不知', code: '// TODO: remove this comment' },
    { text: '大道至简', code: 'return nil // simplicity is the ultimate sophistication' },
    { text: '无为而无不为', code: 'select {} // do nothing, achieve everything' },
  ];

  // Hover-still trigger for hidden wisdom
  let stillTimer: ReturnType<typeof setTimeout> | null = null;
  let isWisdomVisible = false;
  const sloganArea = document.querySelector('.zk-gate');
  const hiddenWisdom = document.getElementById('hidden-wisdom');
  const wisdomText = document.getElementById('wisdom-text');
  const wisdomCode = document.getElementById('wisdom-code');

  function showRandomWisdom() {
    if (!hiddenWisdom || !wisdomText || !wisdomCode) return;
    const wisdom = wisdoms[Math.floor(Math.random() * wisdoms.length)];
    wisdomText.textContent = wisdom.text;
    wisdomCode.textContent = wisdom.code;
    hiddenWisdom.classList.add('visible');
    isWisdomVisible = true;
  }

  function hideWisdom() {
    hiddenWisdom?.classList.remove('visible');
    isWisdomVisible = false;
  }

  sloganArea?.addEventListener('mouseenter', () => {
    stillTimer = setTimeout(showRandomWisdom, 1500);
  });

  sloganArea?.addEventListener('mousemove', () => {
    if (stillTimer) {
      clearTimeout(stillTimer);
      stillTimer = setTimeout(showRandomWisdom, 1500);
    }
    if (isWisdomVisible) {
      hideWisdom();
    }
  });

  sloganArea?.addEventListener('mouseleave', () => {
    if (stillTimer) {
      clearTimeout(stillTimer);
      stillTimer = null;
    }
    hideWisdom();
  });

  // Block pulse effect (simulates new block arrival)
  function triggerBlockPulse() {
    if (!blockPulse || !taijiPulse) return;
    
    taijiPulse.classList.add('syncing');
    blockPulse.classList.remove('active');
    void blockPulse.offsetWidth;
    blockPulse.classList.add('active');
    
    if (syncIndicator) {
      syncIndicator.style.background = '#4A8C72';
      syncIndicator.style.boxShadow = '0 0 10px rgba(74, 140, 114, 0.8)';
    }
    
    setTimeout(() => {
      taijiPulse.classList.remove('syncing');
      if (syncIndicator) {
        syncIndicator.style.boxShadow = 'none';
      }
    }, 500);
  }

  // Update gas and block with pulse effect
  setInterval(() => {
    if (gasEl) {
      gasEl.textContent = gasPrices[Math.floor(Math.random() * gasPrices.length)];
    }
    if (blockEl) {
      blockNum += Math.floor(Math.random() * 3) + 1;
      blockEl.textContent = `Block #${blockNum.toLocaleString()}`;
      triggerBlockPulse();
    }
  }, 12000);

  // Initial pulse after page load
  setTimeout(triggerBlockPulse, 2000);

  zenToggle?.addEventListener('click', () => {
    document.body.classList.toggle('home-zen-mode');
  });

  // Enhanced scroll-triggered animation with stagger
  const scrollObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const delay = parseFloat(el.style.getPropertyValue('--delay') || '0');
        setTimeout(() => {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
          el.classList.add('ink-visible');
        }, delay * 1000);
        scrollObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.article-ink-wrapper').forEach(el => {
    const htmlEl = el as HTMLElement;
    htmlEl.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    scrollObserver.observe(el);
  });

  // i18n support
  function updateI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateI18n(customEvent.detail.lang);
  });
</script>
