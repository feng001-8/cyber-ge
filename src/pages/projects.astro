---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Hydro-Sync',
    description: 'A high-concurrency Go engine designed for fluid data streams and real-time state synchronization.',
    descriptionZh: '高并发 Go 引擎，专为流式数据和实时状态同步设计。',
    element: 'Water',
    elementZh: '水',
    elementChar: '水',
    hexagram: '☵',
    refinement: 'Gold',
    fillLevel: 95,
    tech: ['Go', 'Solidity'],
    deps: ['gRPC', 'Redis', 'PostgreSQL'],
    commits: [
      { date: 'Feb 2024', msg: 'v2.0 release', type: 'major' },
      { date: 'Jan 2024', msg: 'Performance optimization', type: 'minor' },
      { date: 'Dec 2023', msg: 'Added streaming API', type: 'feature' },
      { date: 'Oct 2023', msg: 'Initial commit', type: 'init' },
    ],
    github: 'https://github.com/example/hydro-sync',
    radar: { performance: 95, security: 80, flexibility: 90, scalability: 95, simplicity: 70 },
    readme: `# Hydro-Sync\n\nA high-concurrency Go engine for fluid data streams.\n\n## Features\n- Real-time state synchronization\n- Sub-millisecond latency\n- Horizontal scaling\n\n## Installation\n\`\`\`bash\ngo get github.com/example/hydro-sync\n\`\`\``,
    activity: { githubCommits: 156, contractCalls: 12500 },
  },
  {
    name: 'Torchbearer',
    description: 'AI-driven auditing tool for smart contracts, illuminating vulnerabilities through static analysis.',
    descriptionZh: 'AI 驱动的智能合约审计工具，通过静态分析发现漏洞。',
    element: 'Fire',
    elementZh: '火',
    elementChar: '火',
    hexagram: '☲',
    refinement: 'Silver',
    fillLevel: 70,
    tech: ['Rust', 'Python'],
    deps: ['PyTorch', 'LLVM', 'Slither'],
    commits: [
      { date: 'Feb 2024', msg: 'ML model v3', type: 'major' },
      { date: 'Jan 2024', msg: 'Added reentrancy detection', type: 'feature' },
      { date: 'Nov 2023', msg: 'Initial commit', type: 'init' },
    ],
    github: 'https://github.com/example/torchbearer',
    radar: { performance: 70, security: 95, flexibility: 60, scalability: 50, simplicity: 65 },
    readme: `# Torchbearer\n\nAI-powered smart contract auditor.\n\n## Capabilities\n- Reentrancy detection\n- Integer overflow analysis\n- Gas optimization suggestions\n\n## Usage\n\`\`\`python\nfrom torchbearer import audit\naudit("contract.sol")\n\`\`\``,
    activity: { githubCommits: 89, contractCalls: 3200 },
  },
  {
    name: 'Granite KV',
    description: 'An immutable, append-only key-value store optimized for archival storage. Built for permanence.',
    descriptionZh: '不可变的追加式键值存储，为归档存储优化，追求永恒。',
    element: 'Mountain',
    elementZh: '山',
    elementChar: '山',
    hexagram: '☶',
    refinement: 'Lead',
    fillLevel: 30,
    tech: ['Go', 'RocksDB'],
    deps: ['LevelDB', 'Snappy', 'Protobuf'],
    commits: [
      { date: 'Feb 2024', msg: 'Compaction improvements', type: 'minor' },
      { date: 'Jan 2024', msg: 'Initial commit', type: 'init' },
    ],
    github: 'https://github.com/example/granite-kv',
    radar: { performance: 60, security: 85, flexibility: 30, scalability: 70, simplicity: 80 },
    readme: `# Granite KV\n\nImmutable key-value store for archival.\n\n## Design\n- Append-only writes\n- Merkle tree verification\n- Compression built-in`,
    activity: { githubCommits: 23, contractCalls: 0 },
  },
  {
    name: 'Zephyr Net',
    description: 'Lightweight P2P gossip protocol implementation in Rust. Designed to spread information rapidly.',
    descriptionZh: '轻量级 Rust P2P 八卦协议实现，快速传播信息。',
    element: 'Wind',
    elementZh: '风',
    elementChar: '风',
    hexagram: '☴',
    refinement: 'Silver',
    fillLevel: 60,
    tech: ['Rust', 'libp2p'],
    deps: ['tokio', 'noise', 'yamux'],
    commits: [
      { date: 'Feb 2024', msg: 'NAT traversal', type: 'feature' },
      { date: 'Dec 2023', msg: 'Gossip protocol v2', type: 'major' },
      { date: 'Oct 2023', msg: 'Initial commit', type: 'init' },
    ],
    github: 'https://github.com/example/zephyr-net',
    radar: { performance: 85, security: 75, flexibility: 80, scalability: 90, simplicity: 55 },
    readme: `# Zephyr Net\n\nLightweight P2P gossip protocol.\n\n## Protocol\n- Epidemic broadcast\n- NAT hole punching\n- Encrypted channels`,
    activity: { githubCommits: 67, contractCalls: 890 },
  },
  {
    name: 'Aether Core',
    description: 'The genesis block framework for a new sovereign roll-up chain. Pure logic, initiating action from the void.',
    descriptionZh: '新主权 Rollup 链的创世区块框架。纯粹逻辑，从虚空中发起行动。',
    element: 'Heaven',
    elementZh: '天',
    elementChar: '天',
    hexagram: '☰',
    refinement: 'Gold',
    fillLevel: 95,
    tech: ['Go', 'WASM'],
    deps: ['Cosmos SDK', 'Tendermint', 'IBC'],
    commits: [
      { date: 'Feb 2024', msg: 'Mainnet ready', type: 'major' },
      { date: 'Jan 2024', msg: 'Security audit passed', type: 'milestone' },
      { date: 'Nov 2023', msg: 'Testnet launch', type: 'major' },
      { date: 'Aug 2023', msg: 'Initial commit', type: 'init' },
    ],
    github: 'https://github.com/example/aether-core',
    radar: { performance: 90, security: 95, flexibility: 85, scalability: 95, simplicity: 60 },
    readme: `# Aether Core\n\nSovereign roll-up chain framework.\n\n## Architecture\n- Cosmos SDK based\n- IBC enabled\n- WASM smart contracts`,
    activity: { githubCommits: 234, contractCalls: 45000 },
  },
  {
    name: 'Terra Form',
    description: 'Infrastructure-as-Code library adapting to environment variables gracefully.',
    descriptionZh: '基础设施即代码库，优雅适应环境变量。',
    element: 'Earth',
    elementZh: '土',
    elementChar: '土',
    hexagram: '☷',
    refinement: 'Lead',
    fillLevel: 20,
    tech: ['HCL', 'Go'],
    deps: ['Terraform', 'AWS SDK', 'Docker'],
    commits: [
      { date: 'Feb 2024', msg: 'Initial commit', type: 'init' },
    ],
    github: 'https://github.com/example/terra-form',
    radar: { performance: 40, security: 60, flexibility: 85, scalability: 50, simplicity: 90 },
    readme: `# Terra Form\n\nInfrastructure-as-Code library.\n\n## Status\nEarly development stage.`,
    activity: { githubCommits: 12, contractCalls: 0 },
  },
];

const radarLabels = ['性能', '安全', '灵活', '扩展', '简洁'];
const radarLabelsEn = ['Perf', 'Sec', 'Flex', 'Scale', 'Simple'];

const getGradient = (refinement: string) => {
  if (refinement === 'Gold') return 'from-yellow-600 via-yellow-400 to-yellow-200';
  if (refinement === 'Silver') return 'from-gray-500 via-gray-300 to-gray-200';
  return 'bg-slate-600';
};

const getStageLabel = (level: number) => {
  if (level >= 90) return '纯金 (Pure Gold)';
  if (level >= 70) return '白银 (Silver)';
  if (level >= 50) return '青铜 (Bronze)';
  if (level >= 30) return '生铁 (Iron)';
  return '雏形 (Embryo)';
};

const calculateAlchemyLevel = (activity: { githubCommits: number; contractCalls: number }) => {
  const score = activity.githubCommits * 2 + activity.contractCalls / 100;
  if (score >= 500) return { level: 'Gold', label: '金', color: '#D4AF37', glow: 'rgba(212, 175, 55, 0.5)' };
  if (score >= 200) return { level: 'Silver', label: '银', color: '#C0C0C0', glow: 'rgba(192, 192, 192, 0.5)' };
  return { level: 'Lead', label: '铅', color: '#6B7280', glow: 'rgba(107, 114, 128, 0.3)' };
};
---

<Layout title="炼丹 - Alchemy" description="On-Chain Refinement Lab" currentPage="projects">
  <!-- Qi Flow Background -->
  <div id="qi-flow" class="qi-flow fixed inset-0 pointer-events-none z-0 opacity-30">
    <canvas id="qi-canvas" class="w-full h-full"></canvas>
  </div>

  <!-- README Modal -->
  <div id="readme-modal" class="readme-modal fixed inset-0 z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="readme-backdrop"></div>
    <div class="readme-content relative bg-white rounded-lg shadow-2xl w-full max-w-2xl max-h-[85vh] flex flex-col transform scale-95 transition-transform duration-300">
      <!-- Modal Header -->
      <div class="p-5 border-b border-text-main/10 flex items-center justify-between bg-gradient-to-r from-jade/5 to-transparent shrink-0 rounded-t-lg">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-lg bg-jade/10 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-jade text-xl">description</span>
          </div>
          <div class="min-w-0">
            <h3 id="readme-title" class="font-display text-xl font-bold text-text-main truncate">README.md</h3>
            <span class="text-[10px] font-mono text-text-subtle">Project Documentation</span>
          </div>
        </div>
        <button id="close-readme" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-text-main/10 transition-colors active:scale-95 shrink-0">
          <span class="material-symbols-outlined text-text-subtle">close</span>
        </button>
      </div>
      
      <!-- Modal Content -->
      <div id="readme-body" class="flex-grow overflow-auto p-6 readme-body-content"></div>
      
      <!-- Modal Footer -->
      <div class="p-4 border-t border-text-main/10 bg-gray-50/50 flex items-center justify-between shrink-0 rounded-b-lg">
        <span class="text-[10px] font-mono text-text-subtle">Markdown Preview</span>
        <a id="readme-github-link" href="#" target="_blank" class="flex items-center gap-2 text-xs font-mono text-jade hover:underline">
          <span>View on GitHub</span>
          <span class="material-symbols-outlined text-sm">open_in_new</span>
        </a>
      </div>
    </div>
  </div>

  <main class="relative z-10 flex-grow w-full max-w-6xl mx-auto px-6 py-10">
  <!-- Page Header -->
  <section class="w-full mb-10">
    <span class="i18n font-mono text-jade text-xs tracking-widest uppercase mb-2 block" data-en="The Laboratory" data-zh="炼丹实验室">The Laboratory</span>
    <h1 class="font-display font-black text-4xl md:text-5xl text-text-main tracking-tight mb-1">
      炼丹
    </h1>
    <p class="i18n text-text-subtle font-display text-base italic" data-en="Transmuting raw logic into digital gold." data-zh="将原始逻辑炼化为数字黄金">
      Transmuting raw logic into digital gold.
    </p>
  </section>
  
  <!-- Projects Grid -->
  <section class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 relative z-10">
    {projects.map((project, idx) => {
      const alchemy = calculateAlchemyLevel(project.activity);
      return (
      <article 
        class="project-card group relative flex flex-col bg-white/95 backdrop-blur-sm border border-text-main/5 rounded-sm overflow-hidden transition-all duration-500 hover:shadow-xl cursor-pointer"
        data-project={idx}
        data-alchemy={alchemy.level}
      >
        <!-- Alchemy Level Badge -->
        <div 
          class="alchemy-badge absolute top-3 right-3 w-8 h-8 rounded-full flex items-center justify-center font-display text-sm z-20 transition-all duration-300"
          style={`background: ${alchemy.color}; box-shadow: 0 0 15px ${alchemy.glow};`}
          title={`炼化等级: ${alchemy.label}`}
        >
          <span class="text-white font-bold">{alchemy.label}</span>
        </div>

        <!-- Card Header -->
        <div class="p-5 pb-3 border-b border-dashed border-text-main/10">
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-full border border-jade/20 flex items-center justify-center font-display text-base text-jade">
                {project.elementChar}
              </div>
              <div>
                <h3 class="font-display text-lg font-bold text-text-main group-hover:text-jade transition-colors">{project.name}</h3>
                <span class="i18n font-mono text-[9px] text-text-subtle uppercase tracking-wider" data-en={project.element} data-zh={project.elementZh}>{project.element}</span>
              </div>
            </div>
            <span class="text-2xl text-text-main/10 group-hover:text-jade/20 transition-colors">{project.hexagram}</span>
          </div>
        </div>

        <!-- Card Body -->
        <div class="p-5 flex-grow">
          <p class="i18n text-text-subtle text-sm leading-relaxed mb-3" data-en={project.description} data-zh={project.descriptionZh}>
            {project.description}
          </p>
          
          <!-- Activity Stats -->
          <div class="flex items-center gap-3 mb-3 text-[9px] font-mono text-text-subtle">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-[10px]">commit</span>
              {project.activity.githubCommits} commits
            </span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-[10px]">bolt</span>
              {project.activity.contractCalls.toLocaleString()} calls
            </span>
          </div>
          
          <!-- Tech Stack -->
          <div class="flex flex-wrap gap-1.5 mb-3">
            {project.tech.map((t) => (
              <span class="px-1.5 py-0.5 bg-jade/5 text-jade text-[9px] font-mono rounded">{t}</span>
            ))}
          </div>
        </div>

        <!-- Incense Progress Bar -->
        <div class="px-5 pb-3">
          <div class="flex items-center justify-between mb-1.5">
            <span class="i18n text-[9px] font-mono text-text-subtle uppercase tracking-wider" data-en="Refinement Stage" data-zh="炼化阶段">Refinement Stage</span>
            <span class="text-[9px] font-mono text-jade">{getStageLabel(project.fillLevel)}</span>
          </div>
          <div class="incense-bar relative h-1.5 bg-text-main/5 rounded-full overflow-hidden">
            <div 
              class="incense-fill absolute left-0 top-0 h-full rounded-full transition-all duration-1000"
              style={`width: ${project.fillLevel}%;`}
              data-level={project.fillLevel}
            >
              <div class="incense-glow absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full animate-pulse"></div>
            </div>
          </div>
        </div>

        <!-- Card Footer -->
        <div class="p-5 pt-3 border-t border-text-main/5 bg-background-light/50 flex gap-1.5">
          <button class="expand-btn flex-1 flex items-center justify-center gap-1.5 font-mono text-[10px] text-text-main hover:text-jade transition-colors py-1.5 rounded border border-transparent hover:border-jade/20">
            <span class="material-symbols-outlined text-xs">account_tree</span>
            <span class="i18n" data-en="Evolution" data-zh="演化">Evolution</span>
          </button>
          <button 
            class="radar-btn flex-1 flex items-center justify-center gap-1.5 font-mono text-[10px] text-text-main hover:text-jade transition-colors py-1.5 rounded border border-transparent hover:border-jade/20"
            data-radar={JSON.stringify(project.radar)}
            data-name={project.name}
          >
            <span class="material-symbols-outlined text-xs">radar</span>
            <span>五行</span>
          </button>
          <button 
            class="readme-btn flex-1 flex items-center justify-center gap-1.5 font-mono text-[10px] text-text-main hover:text-jade transition-colors py-1.5 rounded border border-transparent hover:border-jade/20"
            data-readme={project.readme}
            data-name={project.name}
            data-github={project.github}
          >
            <span class="material-symbols-outlined text-xs">description</span>
            <span>README</span>
          </button>
        </div>

        <!-- Expanded Panel (Hidden by default) -->
        <div class="expanded-panel hidden absolute inset-0 bg-white z-30 overflow-auto">
          <div class="p-6">
            <!-- Close Button -->
            <button class="close-panel absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full hover:bg-text-main/5 transition-colors">
              <span class="material-symbols-outlined text-text-subtle">close</span>
            </button>

            <!-- Header -->
            <div class="flex items-center gap-3 mb-6 pr-10">
              <span class="text-3xl">{project.hexagram}</span>
              <div>
                <h3 class="font-display text-2xl font-bold text-text-main">{project.name}</h3>
                <span class="i18n font-mono text-xs text-jade" data-en={`${project.element} Element`} data-zh={`${project.elementZh}元素`}>{project.element} Element</span>
              </div>
            </div>

            <!-- Two Column Layout -->
            <div class="grid grid-cols-2 gap-6">
              <!-- Left: Evolution Timeline -->
              <div>
                <h4 class="font-mono text-xs text-text-subtle uppercase tracking-wider mb-4 flex items-center gap-2">
                  <span class="material-symbols-outlined text-sm">timeline</span>
                  <span class="i18n" data-en="Evolution Trace" data-zh="演化轨迹">Evolution Trace</span>
                </h4>
                <div class="relative pl-4 border-l border-jade/30">
                  {project.commits.map((commit, i) => (
                    <div class="relative mb-4 last:mb-0">
                      <div class={`absolute -left-[1.1rem] w-2 h-2 rounded-full ${commit.type === 'major' ? 'bg-jade' : commit.type === 'init' ? 'bg-cinnabar' : 'bg-text-subtle/30'}`}></div>
                      <div class="text-[10px] font-mono text-text-subtle mb-0.5">{commit.date}</div>
                      <div class="text-sm text-text-main">{commit.msg}</div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Right: Dependencies -->
              <div>
                <h4 class="font-mono text-xs text-text-subtle uppercase tracking-wider mb-4 flex items-center gap-2">
                  <span class="material-symbols-outlined text-sm">hub</span>
                  <span class="i18n" data-en="Dependencies" data-zh="依赖">Dependencies</span>
                </h4>
                <div class="space-y-2">
                  {project.deps.map((dep) => (
                    <div class="flex items-center gap-2 p-2 bg-background-light rounded">
                      <div class="w-6 h-6 rounded border border-text-main/10 flex items-center justify-center">
                        <span class="text-[10px] font-mono text-jade">{dep.charAt(0)}</span>
                      </div>
                      <span class="text-xs font-mono text-text-main">{dep}</span>
                    </div>
                  ))}
                </div>

                <!-- Incense Stage Indicator -->
                <div class="mt-6 p-4 bg-jade/5 rounded">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="incense-icon w-1 h-16 bg-gradient-to-t from-cinnabar via-cinnabar/50 to-transparent rounded-full relative">
                      <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-3 h-3 bg-cinnabar/20 rounded-full animate-ping"></div>
                    </div>
                    <div>
                      <div class="i18n text-xs font-mono text-text-subtle" data-en="Current Stage" data-zh="当前阶段">Current Stage</div>
                      <div class="text-lg font-display font-bold text-jade">{getStageLabel(project.fillLevel)}</div>
                    </div>
                  </div>
                  <div class="h-2 bg-text-main/5 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-cinnabar via-jade to-yellow-500 rounded-full" style={`width: ${project.fillLevel}%;`}></div>
                  </div>
                  <div class="flex justify-between mt-1 text-[8px] font-mono text-text-subtle">
                    <span>雏形</span>
                    <span>生铁</span>
                    <span>青铜</span>
                    <span>白银</span>
                    <span>纯金</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- GitHub Link -->
            <a href={project.github} target="_blank" class="mt-6 flex items-center justify-center gap-2 p-3 border border-text-main/10 rounded hover:border-jade/30 hover:bg-jade/5 transition-all">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              <span class="i18n font-mono text-xs" data-en="View on GitHub" data-zh="在 GitHub 查看">View on GitHub</span>
            </a>
          </div>
        </div>
      </article>
    );})}
  </section>
  </main>
</Layout>

<style>
  .qi-flow {
    background: transparent;
  }

  .qi-flow canvas {
    display: block;
  }

  .alchemy-badge {
    animation: alchemy-glow 2s ease-in-out infinite;
  }

  @keyframes alchemy-glow {
    0%, 100% { filter: brightness(1); }
    50% { filter: brightness(1.2); }
  }

  .project-card[data-alchemy="Gold"] {
    border-color: rgba(212, 175, 55, 0.3);
  }

  .project-card[data-alchemy="Gold"]:hover {
    box-shadow: 0 0 30px rgba(212, 175, 55, 0.2);
  }

  .project-card[data-alchemy="Silver"]:hover {
    box-shadow: 0 0 30px rgba(192, 192, 192, 0.2);
  }

  .incense-fill {
    background: linear-gradient(90deg, 
      var(--color-cinnabar) 0%, 
      var(--color-jade) 50%, 
      #d4af37 100%
    );
  }

  .incense-glow {
    background: radial-gradient(circle, #d4af37 0%, transparent 70%);
    box-shadow: 0 0 8px 2px rgba(212, 175, 55, 0.5);
  }

  .project-card {
    min-height: 280px;
  }

  .expanded-panel {
    animation: bamboo-unfold 0.4s ease-out;
  }

  @keyframes bamboo-unfold {
    0% { clip-path: inset(0 100% 0 0); opacity: 0; }
    100% { clip-path: inset(0 0 0 0); opacity: 1; }
  }

  .expanded-panel.closing {
    animation: bamboo-fold 0.3s ease-in forwards;
  }

  @keyframes bamboo-fold {
    0% { clip-path: inset(0 0 0 0); opacity: 1; }
    100% { clip-path: inset(0 100% 0 0); opacity: 0; }
  }

  .readme-modal.open {
    opacity: 1;
    pointer-events: auto;
  }

  .readme-modal.open .readme-content {
    transform: scale(1);
  }

  /* README Content Styling */
  .readme-body-content {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-main);
  }

  .readme-body-content h1 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-jade);
  }

  .readme-body-content h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .readme-body-content p {
    margin-bottom: 1rem;
    color: var(--color-text-subtle);
  }

  .readme-body-content ul, .readme-body-content ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .readme-body-content li {
    margin-bottom: 0.5rem;
    color: var(--color-text-subtle);
    position: relative;
  }

  .readme-body-content li::before {
    content: '•';
    color: var(--color-jade);
    font-weight: bold;
    position: absolute;
    left: -1rem;
  }

  .readme-body-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(74, 139, 113, 0.1);
    color: var(--color-jade);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
  }

  .readme-body-content pre {
    background: #1e201f;
    color: #a9b7c6;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .readme-body-content pre code {
    background: none;
    color: inherit;
    padding: 0;
  }

  /* Radar Modal */
  .radar-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .radar-modal.open {
    opacity: 1;
    pointer-events: auto;
  }

  .radar-content {
    background: white;
    border-radius: 0.5rem;
    padding: 2rem;
    max-width: 400px;
    width: 90%;
    transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .radar-modal.open .radar-content {
    transform: scale(1);
  }
</style>

<!-- Radar Modal -->
<div id="radar-modal" class="radar-modal">
  <div class="radar-content">
    <div class="flex items-center justify-between mb-6">
      <h3 id="radar-title" class="font-display text-xl font-bold text-text-main">五行解析</h3>
      <button id="close-radar" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-text-main/5">
        <span class="material-symbols-outlined text-text-subtle">close</span>
      </button>
    </div>
    <div class="relative w-full aspect-square">
      <svg id="radar-chart" viewBox="0 0 200 200" class="w-full h-full">
        <!-- Pentagon Grid -->
        <polygon points="100,20 180,65 155,155 45,155 20,65" fill="none" stroke="#e5e7eb" stroke-width="1"/>
        <polygon points="100,40 160,72 140,140 60,140 40,72" fill="none" stroke="#e5e7eb" stroke-width="1"/>
        <polygon points="100,60 140,80 125,125 75,125 60,80" fill="none" stroke="#e5e7eb" stroke-width="1"/>
        <polygon points="100,80 120,88 110,110 90,110 80,88" fill="none" stroke="#e5e7eb" stroke-width="1"/>
        <!-- Axes -->
        <line x1="100" y1="100" x2="100" y2="20" stroke="#e5e7eb" stroke-width="1"/>
        <line x1="100" y1="100" x2="180" y2="65" stroke="#e5e7eb" stroke-width="1"/>
        <line x1="100" y1="100" x2="155" y2="155" stroke="#e5e7eb" stroke-width="1"/>
        <line x1="100" y1="100" x2="45" y2="155" stroke="#e5e7eb" stroke-width="1"/>
        <line x1="100" y1="100" x2="20" y2="65" stroke="#e5e7eb" stroke-width="1"/>
        <!-- Data Polygon -->
        <polygon id="radar-data" points="" fill="rgba(74, 140, 114, 0.3)" stroke="#4A8B71" stroke-width="2"/>
        <!-- Labels -->
        <text x="100" y="10" text-anchor="middle" class="text-[10px] fill-text-subtle">性能</text>
        <text x="190" y="65" text-anchor="start" class="text-[10px] fill-text-subtle">安全</text>
        <text x="165" y="165" text-anchor="start" class="text-[10px] fill-text-subtle">灵活</text>
        <text x="35" y="165" text-anchor="end" class="text-[10px] fill-text-subtle">扩展</text>
        <text x="10" y="65" text-anchor="end" class="text-[10px] fill-text-subtle">简洁</text>
      </svg>
    </div>
    <div class="mt-4 grid grid-cols-5 gap-2 text-center">
      <div class="text-[10px] font-mono"><span class="block text-jade font-bold" id="val-perf">0</span>性能</div>
      <div class="text-[10px] font-mono"><span class="block text-jade font-bold" id="val-sec">0</span>安全</div>
      <div class="text-[10px] font-mono"><span class="block text-jade font-bold" id="val-flex">0</span>灵活</div>
      <div class="text-[10px] font-mono"><span class="block text-jade font-bold" id="val-scale">0</span>扩展</div>
      <div class="text-[10px] font-mono"><span class="block text-jade font-bold" id="val-simp">0</span>简洁</div>
    </div>
  </div>
</div>

<script>
  const readmeModal = document.getElementById('readme-modal');
  const readmeTitle = document.getElementById('readme-title');
  const readmeBody = document.getElementById('readme-body');
  const closeReadme = document.getElementById('close-readme');
  const readmeBackdrop = document.getElementById('readme-backdrop');

  const radarModal = document.getElementById('radar-modal');
  const radarData = document.getElementById('radar-data');
  const radarTitle = document.getElementById('radar-title');
  const closeRadar = document.getElementById('close-radar');

  function calculateRadarPoints(data: any) {
    const center = 100;
    const maxRadius = 80;
    const angles = [-90, -18, 54, 126, 198].map(a => a * Math.PI / 180);
    const values = [data.performance, data.security, data.flexibility, data.scalability, data.simplicity];
    
    return values.map((v, i) => {
      const r = (v / 100) * maxRadius;
      const x = center + r * Math.cos(angles[i]);
      const y = center + r * Math.sin(angles[i]);
      return `${x},${y}`;
    }).join(' ');
  }

  document.querySelectorAll('.project-card').forEach(card => {
    const expandBtn = card.querySelector('.expand-btn');
    const closeBtn = card.querySelector('.close-panel');
    const panel = card.querySelector('.expanded-panel');
    const radarBtn = card.querySelector('.radar-btn');
    const readmeBtn = card.querySelector('.readme-btn');

    expandBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      panel?.classList.remove('hidden', 'closing');
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      panel?.classList.add('closing');
      setTimeout(() => {
        panel?.classList.add('hidden');
        panel?.classList.remove('closing');
      }, 300);
    });

    radarBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const data = JSON.parse((radarBtn as HTMLElement).dataset.radar || '{}');
      const name = (radarBtn as HTMLElement).dataset.name || '';
      
      if (radarTitle) radarTitle.textContent = `${name} - 五行解析`;
      if (radarData) radarData.setAttribute('points', calculateRadarPoints(data));
      
      document.getElementById('val-perf')!.textContent = data.performance;
      document.getElementById('val-sec')!.textContent = data.security;
      document.getElementById('val-flex')!.textContent = data.flexibility;
      document.getElementById('val-scale')!.textContent = data.scalability;
      document.getElementById('val-simp')!.textContent = data.simplicity;
      
      radarModal?.classList.add('open');
    });

    readmeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const readme = (readmeBtn as HTMLElement).dataset.readme || '';
      const name = (readmeBtn as HTMLElement).dataset.name || '';
      const github = (readmeBtn as HTMLElement).dataset.github || '#';
      
      if (readmeTitle) readmeTitle.textContent = `${name}`;
      if (readmeBody) {
        const htmlContent = parseReadme(readme);
        readmeBody.innerHTML = htmlContent;
      }
      
      const githubLink = document.getElementById('readme-github-link');
      if (githubLink) githubLink.setAttribute('href', github);
      
      readmeModal?.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  function parseReadme(text: string): string {
    return text
      .replace(/^# (.+)$/gm, '<h1>$1</h1>')
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^- (.+)$/gm, '<li>$1</li>')
      .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
      .replace(/```(\w+)?\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/^(?!<[hup]|<li|<pre)(.+)$/gm, '<p>$1</p>')
      .replace(/<p><\/p>/g, '');
  }

  function closeReadmeModal() {
    readmeModal?.classList.remove('open');
    document.body.style.overflow = '';
  }

  closeReadme?.addEventListener('click', closeReadmeModal);
  readmeBackdrop?.addEventListener('click', closeReadmeModal);

  closeRadar?.addEventListener('click', () => {
    radarModal?.classList.remove('open');
  });

  radarModal?.addEventListener('click', (e) => {
    if (e.target === radarModal) {
      radarModal.classList.remove('open');
    }
  });

  // Escape key to close modals
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (readmeModal?.classList.contains('open')) {
        closeReadmeModal();
      }
      if (radarModal?.classList.contains('open')) {
        radarModal.classList.remove('open');
      }
    }
  });

  // Qi Flow Background Animation
  const canvas = document.getElementById('qi-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let particles: Array<{x: number; y: number; vx: number; vy: number; life: number; maxLife: number}> = [];
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let mouseSpeed = 0;
    let lastMouseX = mouseX;
    let lastMouseY = mouseY;
    let entropy = 0.5;

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    document.addEventListener('mousemove', (e) => {
      const dx = e.clientX - lastMouseX;
      const dy = e.clientY - lastMouseY;
      mouseSpeed = Math.sqrt(dx * dx + dy * dy);
      lastMouseX = mouseX;
      lastMouseY = mouseY;
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      entropy = Math.min(1, Math.max(0.1, mouseSpeed / 50));
    });

    function createParticle() {
      return {
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 2,
        vy: (Math.random() - 0.5) * 2,
        life: 0,
        maxLife: 100 + Math.random() * 100
      };
    }

    for (let i = 0; i < 50; i++) {
      particles.push(createParticle());
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      entropy *= 0.98;
      entropy = Math.max(0.1, entropy);

      particles.forEach((p, i) => {
        const dx = mouseX - p.x;
        const dy = mouseY - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        
        if (entropy > 0.5) {
          p.vx += (Math.random() - 0.5) * entropy * 0.5;
          p.vy += (Math.random() - 0.5) * entropy * 0.5;
        } else {
          if (dist < 200) {
            p.vx += dx * 0.0001;
            p.vy += dy * 0.0001;
          }
        }

        p.vx *= 0.99;
        p.vy *= 0.99;
        p.x += p.vx;
        p.y += p.vy;
        p.life++;

        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;

        const alpha = Math.sin((p.life / p.maxLife) * Math.PI) * 0.3;
        const size = 2 + entropy * 3;
        
        ctx.beginPath();
        ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(74, 140, 114, ${alpha})`;
        ctx.fill();

        if (p.life > p.maxLife) {
          particles[i] = createParticle();
        }
      });

      particles.forEach((p1, i) => {
        particles.slice(i + 1).forEach(p2 => {
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 80) {
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(74, 140, 114, ${0.1 * (1 - dist / 80)})`;
            ctx.stroke();
          }
        });
      });

      requestAnimationFrame(animate);
    }
    animate();
  }

  // i18n support
  function updateI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateI18n(customEvent.detail.lang);
  });
</script>
