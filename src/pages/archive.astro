---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    name: 'Tools',
    nameZh: '工具',
    element: 'Metal',
    elementZh: '金',
    elementChar: '金',
    icon: 'construction',
    items: [
      { name: 'gosec-scanner', type: 'v2.1', seal: '上品', summary: 'Automated security analysis for Go codebases.', summaryZh: 'Go 代码库自动安全分析工具。' },
      { name: 'eth-debugger', type: 'v0.9', seal: '妙用', summary: 'Visual transaction tracer for EVM execution.', summaryZh: 'EVM 执行可视化交易追踪器。' },
      { name: 'protoc-gen-go', type: 'plugin', seal: '利器', summary: 'Custom protobuf generator for microservices.', summaryZh: '微服务自定义 protobuf 生成器。' },
      { name: 'solc-optimizer', type: 'v0.8', seal: '精简', summary: 'Bytecode optimizer for Solidity contracts.', summaryZh: 'Solidity 合约字节码优化器。' },
    ]
  },
  {
    name: 'Reading',
    nameZh: '书单',
    element: 'Wood',
    elementZh: '木',
    elementChar: '木',
    icon: 'menu_book',
    items: [
      { name: 'Tao of Programming', type: 'Book', seal: '经典', summary: 'Satirical koans on coding and corporate life.', summaryZh: '关于编程与职场的讽刺公案。' },
      { name: 'Yellow Paper', type: 'Paper', seal: '必读', summary: 'The technical specification of Ethereum.', summaryZh: '以太坊技术规范白皮书。' },
      { name: 'Generative Deep Learning', type: 'Article', seal: '新知', summary: 'Exploration of GANs and VAEs architecture.', summaryZh: 'GAN 和 VAE 架构探索。' },
      { name: 'DDIA', type: 'Book', seal: '圣经', summary: 'Designing Data-Intensive Applications.', summaryZh: '设计数据密集型应用。' },
    ]
  },
  {
    name: 'Templates',
    nameZh: '模板',
    element: 'Water',
    elementZh: '水',
    elementChar: '水',
    icon: 'water_drop',
    items: [
      { name: 'clean-arch-go', type: 'Repo', seal: '模式', summary: "Uncle Bob's Clean Architecture structure for Go.", summaryZh: 'Bob 大叔的 Go 整洁架构模板。' },
      { name: 'solidity-foundry', type: 'Repo', seal: '基石', summary: 'Foundry starter kit with gas optimization.', summaryZh: 'Foundry 启动套件，含 Gas 优化。' },
      { name: 'k8s-helm-chart', type: 'Conf', seal: '部署', summary: 'Production-ready Helm charts for microservices.', summaryZh: '生产级微服务 Helm 图表。' },
    ]
  },
  {
    name: 'Snippets',
    nameZh: '碎片',
    element: 'Fire',
    elementZh: '火',
    elementChar: '火',
    icon: 'local_fire_department',
    items: [
      { name: 'Merkle Proof', type: 'Go', seal: '验证', summary: 'Efficient Merkle tree verification implementation.', summaryZh: '高效 Merkle 树验证实现。' },
      { name: 'Async Mutex', type: 'Rust', seal: '并发', summary: 'Handling async locks without deadlocks.', summaryZh: '无死锁异步锁处理。' },
      { name: 'Prompt Chain', type: 'Py', seal: '智能', summary: 'Sequential LLM prompting logic pattern.', summaryZh: '顺序 LLM 提示逻辑模式。' },
      { name: 'ZK Circuit', type: 'Circom', seal: '隐秘', summary: 'Zero-knowledge proof circuit template.', summaryZh: '零知识证明电路模板。' },
    ]
  }
];
---

<Layout title="归藏 - Archive" description="The Vault of Sundries" currentPage="archive">
  <main class="relative z-10 flex-grow w-full max-w-6xl mx-auto px-6 py-10">
  <!-- Page Header -->
  <section class="w-full mb-10">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <span class="i18n font-mono text-jade text-xs tracking-widest uppercase mb-2 block" data-en="Digital Drawers • Curated Resources" data-zh="数字抽屉 • 精选资源">Digital Drawers • Curated Resources</span>
        <h1 class="font-display text-4xl md:text-5xl font-black text-text-main tracking-tight mb-1">归藏</h1>
        <p class="i18n font-display text-base text-text-subtle italic" data-en="The Vault of Sundries" data-zh="数字百宝箱">The Vault of Sundries</p>
      </div>
      <!-- Search -->
      <div class="w-full md:w-64 relative group">
        <input 
          type="text" 
          class="peer w-full bg-transparent border-0 border-b border-text-main/30 focus:border-jade focus:ring-0 px-0 py-2 placeholder-transparent font-mono text-sm transition-colors" 
          placeholder=" "
        />
        <label class="i18n absolute left-0 -top-3.5 text-text-subtle text-xs font-mono transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-text-subtle peer-placeholder-shown:top-2 peer-focus:-top-3.5 peer-focus:text-jade peer-focus:text-xs" data-en="Seek the Hidden" data-zh="搜索资源">
          Seek the Hidden
        </label>
        <span class="material-symbols-outlined absolute right-0 top-2 text-text-subtle peer-focus:text-jade text-lg">search</span>
      </div>
    </div>
  </section>

  <!-- Four Elements Grid -->
  <div class="w-full grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-10 xl:gap-6">
    {categories.map((category) => (
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2 border-b-2 border-text-main/10 pb-2 mb-2">
          <span class="material-symbols-outlined text-text-subtle text-lg">{category.icon}</span>
          <h2 class="i18n font-display font-bold text-lg" data-en={category.name} data-zh={category.nameZh}>{category.name}</h2>
          <span class="i18n text-[10px] font-mono text-text-subtle ml-auto" data-en={`[${category.element}]`} data-zh={`[${category.elementZh}]`}>[{category.element}]</span>
        </div>
        <div class="space-y-0.5">
          {category.items.map((item) => (
            <div class="group item-row relative py-2 cursor-pointer">
              <a href="#" class="absolute inset-0 z-10"></a>
              <div class="flex justify-between items-baseline border-b border-dashed border-text-main/20 pb-2 group-hover:border-jade transition-colors">
                <span class="font-mono text-sm font-medium text-text-main group-hover:text-jade transition-colors">{item.name}</span>
                <span class="text-xs text-text-subtle">{item.type}</span>
              </div>
              <div class="seal-stamp">{item.seal.split('').join('\n')}</div>
              <div class="summary-tooltip i18n-summary" data-en={item.summary} data-zh={item.summaryZh}>{item.summary}</div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Element Legend -->
  <section class="w-full mt-16 pt-10 border-t border-dashed border-text-main/10">
    <div class="flex flex-wrap justify-center gap-6 text-center">
      {categories.map((cat) => (
        <div class="flex flex-col items-center gap-1.5 opacity-60 hover:opacity-100 transition-opacity">
          <div class="w-8 h-8 rounded-full border border-text-main/20 flex items-center justify-center font-display text-base">
            {cat.elementChar}
          </div>
          <span class="i18n text-[10px] font-mono text-text-subtle" data-en={cat.element} data-zh={cat.elementZh}>{cat.element}</span>
        </div>
      ))}
    </div>
  </section>
  </main>
</Layout>

<style>
  .seal-stamp {
    position: absolute;
    right: -2rem;
    top: 50%;
    transform: translateY(-50%) rotate(12deg);
    border: 2px solid #D13429;
    color: #D13429;
    padding: 4px;
    font-family: "Noto Serif SC", serif;
    font-weight: bold;
    font-size: 0.75rem;
    line-height: 1.2;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    mix-blend-mode: multiply;
    white-space: pre-line;
    text-align: center;
  }

  .item-row:hover .seal-stamp {
    opacity: 0.8;
    transform: translateY(-50%) rotate(0deg);
  }

  .summary-tooltip {
    position: absolute;
    left: 0;
    bottom: -2rem;
    z-index: 20;
    background: var(--color-text-main);
    color: white;
    font-size: 0.75rem;
    padding: 0.5rem;
    border-radius: 0.25rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    width: 100%;
    font-family: var(--font-body);
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .item-row:hover .summary-tooltip {
    opacity: 1;
    transform: translateY(0);
  }

  .item-row {
    overflow: visible;
  }
</style>

<script>
  // i18n support
  function updateI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
    
    document.querySelectorAll('.i18n-summary').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateI18n(customEvent.detail.lang);
  });
</script>
