---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const posts: Record<string, any> = {
  'uniswap-v4-architecture': {
    ganZhi: 'BING WU YEAR • MONTH OF THE TIGER',
    readTime: '15 min read',
    category: 'DeFi',
    aiNote: "单例模式的精妙在于集中——分散的流动性汇聚一处，Gas 消耗也从乘法变为加法。",
    reference: { title: 'Uniswap V4 白皮书', desc: 'Hooks 机制与单例架构设计。' },
    synthesis: "Hooks 让每个池子成为可编程的实体——从「一刀切」到「因地制宜」。",
  },
  'uniswap-v4-data-integration': {
    ganZhi: 'BING WU YEAR • MONTH OF THE TIGER',
    readTime: '12 min read',
    category: 'DeFi',
    aiNote: "批量查询的本质是「聚沙成塔」——单次调用获取多池数据，RPC 开销从 O(n) 降为 O(1)。",
    reference: { title: 'StateView 合约', desc: 'V4 官方状态查询接口。' },
    synthesis: "事件驱动的本质是「无为而治」——不主动轮询，而是等待变化自己到来。",
  },
  'curve-cryptoswap-formula': {
    ganZhi: 'BING WU YEAR • MONTH OF THE TIGER',
    readTime: '20 min read',
    category: 'DeFi',
    aiNote: "从数量到价值的转换，是 CryptoSwap 突破 StableSwap 局限的关键——万物皆可标准化，只要找到正确的度量。",
    reference: { title: 'Curve CryptoSwap 白皮书', desc: '原始论文，包含完整数学推导。' },
    synthesis: "Repegging 机制如同太极推手——不与市场对抗，而是顺势而为，渐进调整。",
  },
  'dex-aggregator-routing-algorithm': {
    ganZhi: 'BING WU YEAR • MONTH OF THE TIGER',
    readTime: '20 min read',
    category: 'DeFi',
    aiNote: "从 500 万到 1000，再到 16——层层筛选如同大浪淘沙，最终留下的是真金。",
    reference: { title: '1inch Pathfinder', desc: 'DEX 聚合协议的路由算法文档。' },
    synthesis: "价格平衡的本质是让所有路由「水位」趋于一致——这是连通器原理在金融领域的应用。",
  },
  'curve-stableswap-formula': {
    ganZhi: 'BING WU YEAR • MONTH OF THE TIGER',
    readTime: '15 min read',
    category: 'DeFi',
    aiNote: "曲线的弯曲程度，决定了流动性的深浅——StableSwap 在平衡中寻找最优，如同太极的阴阳调和。",
    reference: { title: 'Curve StableSwap 白皮书', desc: '原始论文，包含完整数学推导。' },
    synthesis: "动态参数 χ 的设计体现了「因地制宜」的智慧——平衡点附近求稳，边缘处求安。",
  },
  'dex-trading-mechanisms': {
    ganZhi: 'BING WU YEAR • MONTH OF THE TIGER',
    readTime: '18 min read',
    category: 'DeFi',
    aiNote: "流动性如水，自然流向阻力最小之处——AMM 不过是将这一自然法则形式化。",
    reference: { title: 'Uniswap V3 Whitepaper', desc: '集中流动性与资本效率。' },
    synthesis: "意图系统代表了从「如何做」到「做什么」的转变——用户声明结果，求解器竞争执行。",
  },
  'garbage-collection-in-go': {
    ganZhi: 'GUI MAO YEAR • MONTH OF THE TIGER',
    readTime: '12 min read',
    category: 'Architecture',
    aiNote: "The concept of 'Interface' in Go mirrors the Taoist principle of wu-wei—action through non-action. You define behavior, not identity.",
    reference: { title: 'Go 1.18 Release Notes', desc: 'Official documentation on Type Parameters.' },
    synthesis: "This pattern is similar to Rust's Traits, but without the lifetime complexity. Does this simplify smart contract indexing?",
  },
  'building-decentralized-oracles': {
    ganZhi: 'GUI MAO YEAR • MONTH OF THE DOG',
    readTime: '15 min read',
    category: 'Web3',
    aiNote: "Oracles bridge the gap between on-chain and off-chain worlds—like the ancient shamans who interpreted signs from nature.",
    reference: { title: 'Chainlink Documentation', desc: 'Decentralized oracle network architecture.' },
    synthesis: "The trust model here shifts from centralized authorities to cryptographic proofs. A fundamental paradigm shift.",
  },
  'smart-contracts-immutable-past': {
    ganZhi: 'JIA CHEN YEAR • MONTH OF THE OX',
    readTime: '10 min read',
    category: 'Ethics',
    aiNote: "Immutability is both a feature and a burden. Once written, code becomes law—for better or worse.",
    reference: { title: 'The DAO Hack', desc: 'A case study in immutable mistakes.' },
    synthesis: "Can we reconcile the need for correction with the promise of permanence?",
  },
  'neural-networks-as-water': {
    ganZhi: 'GUI MAO YEAR • MONTH OF THE RAT',
    readTime: '8 min read',
    category: 'AI',
    aiNote: "Like water, neural networks find the path of least resistance—gradient descent as natural flow.",
    reference: { title: 'Attention Is All You Need', desc: 'The transformer architecture paper.' },
    synthesis: "Can we design AI systems that adapt like water, rather than forcing rigid structures?",
  },
  'zero-knowledge-infinite-potential': {
    ganZhi: 'GUI MAO YEAR • MONTH OF THE PIG',
    readTime: '14 min read',
    category: 'Cryptography',
    aiNote: "Proving knowledge without revealing it—the ultimate expression of 'knowing without showing'.",
    reference: { title: 'ZK-SNARKs Explained', desc: 'A gentle introduction to zero-knowledge proofs.' },
    synthesis: "Privacy and transparency coexisting—a paradox resolved through mathematics.",
  },
};

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.id;
const postMeta = posts[slug as string] || {
  ganZhi: '',
  readTime: '10 min read',
  category: 'Article',
  aiNote: '',
  reference: { title: '', desc: '' },
  synthesis: '',
};

const { Content } = await render(entry);

const formattedDate = new Date(entry.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const relatedPosts = [
  { trigram: '☴', title: 'The Wind of Concurrency', desc: 'Exploring Goroutines and Channels through the lens of fluid dynamics.', date: 'DEC 02' },
  { trigram: '☲', title: 'Burning Gas: EVM Optimization', desc: 'How to minimize transaction costs by understanding opcode execution.', date: 'NOV 15' },
  { trigram: '☷', title: 'Grounding Data: IPFS & Filecoin', desc: 'Permanent storage solutions for a decentralized web.', date: 'OCT 08' },
];
---

<Layout title={entry.data.title} description={entry.data.description} currentPage="blog">
  <main class="relative z-10 flex-grow w-full max-w-6xl mx-auto px-6 py-8">
  <!-- Reading Progress Bar -->
  <div class="fixed top-0 left-0 w-full h-1 bg-gray-200 z-50">
    <div id="progress-bar" class="h-full bg-jade transition-all duration-150" style="width: 0%;"></div>
  </div>

  <!-- Zen Mode Toggle (Fixed) -->
  <div id="zen-toggle" class="fixed top-20 right-6 z-40 transition-opacity duration-500">
    <button id="zen-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-text-main/20 hover:border-jade/50 text-xs text-text-subtle hover:text-jade transition-all group bg-background-light/80 backdrop-blur-sm">
      <span class="material-symbols-outlined text-[16px]">visibility_off</span>
      <span class="hidden sm:inline i18n" data-en="Zen Mode" data-zh="禅定模式">Zen Mode</span>
    </button>
  </div>

  <!-- Main Content Grid -->
  <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 relative">
    <!-- Left Marginalia -->
    <aside id="left-margin" class="hidden lg:block lg:col-span-2 pt-40 relative transition-opacity duration-500">
      <div class="sticky top-32 space-y-12">
        <div class="absolute -left-2 top-0 h-96 border-l border-text-main/10"></div>
        <div class="writing-vertical-rl text-text-subtle/60 font-mono text-xs tracking-widest h-auto select-none pl-4 pt-2">
          {postMeta.ganZhi}
        </div>
        <div class="relative pl-6">
          <div class="absolute left-0 top-1 w-0.5 h-16 bg-cinnabar/40"></div>
          <span class="i18n block text-[10px] text-cinnabar font-bold uppercase tracking-wider mb-2" data-en="AI Annotator" data-zh="AI 批注">AI Annotator</span>
          <p class="text-sm text-text-subtle italic font-light leading-relaxed">
            "{postMeta.aiNote}"
          </p>
        </div>
      </div>
    </aside>

    <!-- Center Reading Column -->
    <article class="col-span-1 lg:col-span-8 flex flex-col">
      <!-- Header -->
      <header class="text-center mb-16 relative">
        <div class="inline-block px-3 py-1 mb-6 border border-jade/20 rounded-full bg-jade/5 text-jade text-xs font-mono tracking-wider uppercase">
          {postMeta.category} • {postMeta.readTime}
        </div>
        <h1 class="text-4xl md:text-5xl font-display font-bold text-text-main leading-[1.2] tracking-tight mb-8">
          {entry.data.title}
        </h1>
        <div class="flex items-center justify-center gap-4 text-sm text-text-subtle">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-jade/20 flex items-center justify-center">
              <span class="text-jade text-sm">道</span>
            </div>
            <span class="font-medium text-text-main">GE</span>
          </div>
          <span class="w-1 h-1 rounded-full bg-text-subtle/30"></span>
          <time>{formattedDate}</time>
        </div>
      </header>

      <!-- Article Body - Rendered from Markdown -->
      <div class="prose-article">
        <Content />
      </div>

      <!-- Footer / Signoff -->
      <div class="mt-20 pt-10 border-t border-text-main/10 flex flex-col items-center">
        <div class="w-12 h-12 border-2 border-jade/30 rounded-full flex items-center justify-center mb-4">
          <span class="material-symbols-outlined text-jade">edit_note</span>
        </div>
        <p class="text-center font-display italic text-text-subtle max-w-md">
          "Code is poetry written for machines, but read by humans. Optimize for the latter."
        </p>
      </div>

      <!-- Navigation -->
      <div class="mt-12 pt-8 border-t border-dashed border-text-main/10 flex items-center justify-between">
        <a href="/blog" class="flex items-center gap-2 font-mono text-sm text-text-subtle hover:text-jade transition-colors">
          <span class="material-symbols-outlined text-lg">arrow_back</span>
          <span class="i18n" data-en="Back to Archive" data-zh="返回文章列表">Back to Archive</span>
        </a>
        <div class="flex items-center gap-4">
          <span class="i18n font-mono text-xs text-text-subtle" data-en="Share:" data-zh="分享:">Share:</span>
          <button class="text-text-subtle hover:text-jade transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </button>
        </div>
      </div>
    </article>

    <!-- Right Marginalia -->
    <aside id="right-margin" class="hidden lg:block lg:col-span-2 pt-64 relative transition-opacity duration-500">
      <div class="sticky top-64 space-y-8 pl-6">
        <div class="group cursor-pointer">
          <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-cinnabar text-lg mt-0.5">link</span>
            <div>
              <span class="i18n block text-[10px] text-text-subtle font-bold uppercase tracking-wider mb-1" data-en="Reference" data-zh="参考">Reference</span>
              <h4 class="text-sm font-display font-medium text-text-main group-hover:text-jade transition-colors">{postMeta.reference.title}</h4>
              <p class="text-xs text-text-subtle mt-1">{postMeta.reference.desc}</p>
            </div>
          </div>
        </div>
        <div class="group relative">
          <div class="absolute -left-4 top-0 bottom-0 w-0.5 bg-gradient-to-b from-cinnabar/0 via-cinnabar/30 to-cinnabar/0"></div>
          <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-cinnabar text-lg mt-0.5">psychology</span>
            <div>
              <span class="i18n block text-[10px] text-text-subtle font-bold uppercase tracking-wider mb-1" data-en="Synthesizer" data-zh="思考">Synthesizer</span>
              <p class="text-xs text-text-subtle leading-relaxed">
                {postMeta.synthesis}
              </p>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <!-- Related Trigrams -->
  <section class="w-full mt-20 pt-16 border-t border-text-main/10">
    <div class="flex items-center justify-center gap-4 mb-12">
      <div class="h-px w-12 bg-text-main/20"></div>
      <h3 class="i18n text-lg font-display text-text-main tracking-wide" data-en="Related Trigrams" data-zh="相关文章">Related Trigrams</h3>
      <div class="h-px w-12 bg-text-main/20"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {relatedPosts.map((item) => (
        <a href="#" class="group block p-6 rounded-xl hover:bg-white/50 transition-all duration-300 border border-transparent hover:border-text-main/10">
          <div class="flex justify-between items-start mb-4">
            <span class="text-2xl text-jade/80 group-hover:text-jade transition-colors">{item.trigram}</span>
            <span class="text-xs font-mono text-text-subtle">{item.date}</span>
          </div>
          <h4 class="text-xl font-display font-bold text-text-main mb-2 group-hover:text-jade transition-colors">{item.title}</h4>
          <p class="text-sm text-text-subtle line-clamp-2">{item.desc}</p>
        </a>
      ))}
    </div>
  </section>
  </main>
</Layout>

<style>
  .writing-vertical-rl {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .prose-article {
    max-width: 75ch;
    margin-left: auto;
    margin-right: auto;
  }

  .prose-article :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.9;
    color: var(--color-text-main);
    font-size: 1.125rem;
  }

  .prose-article :global(> p:first-of-type::first-letter) {
    font-size: 3rem;
    font-family: var(--font-display);
    color: var(--color-jade);
    float: left;
    margin-right: 0.75rem;
    margin-top: -0.375rem;
    line-height: 1;
  }

  .prose-article :global(ol > li::first-letter),
  .prose-article :global(ul > li::first-letter) {
    font-size: inherit;
    float: none;
    margin: 0;
    color: inherit;
  }

  .prose-article :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    font-family: var(--font-display);
  }

  .prose-article :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text-main);
    font-family: var(--font-display);
  }

  .prose-article :global(code) {
    background: #f3f4f6;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: var(--font-mono);
    color: #1f2937;
  }

  .prose-article :global(pre) {
    background: #f9fafb;
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid #e5e7eb;
  }

  .prose-article :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #1f2937;
  }

  .prose-article :global(pre.astro-code) {
    background: #f9fafb !important;
    color: #1f2937 !important;
    border: 1px solid #e5e7eb;
  }

  .prose-article :global(pre.astro-code span) {
    color: inherit !important;
  }

  .prose-article :global(blockquote) {
    border-left: 3px solid var(--color-jade);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-text-subtle);
  }

  .prose-article :global(ul), .prose-article :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .prose-article :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--color-text-main);
  }

  .prose-article :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .prose-article :global(th) {
    background: rgba(74, 140, 114, 0.1);
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-text-main);
    border-bottom: 2px solid var(--color-jade);
  }

  .prose-article :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    color: var(--color-text-main);
  }

  .prose-article :global(tr:hover) {
    background: rgba(74, 140, 114, 0.05);
  }

  .prose-article :global(hr) {
    border: none;
    border-top: 1px dashed var(--color-text-main);
    opacity: 0.2;
    margin: 3rem 0;
  }

  .prose-article :global(a) {
    color: var(--color-jade);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .prose-article :global(a:hover) {
    border-bottom-color: var(--color-jade);
  }

  .prose-article :global(strong) {
    font-weight: 600;
    color: var(--color-text-main);
  }

  body.zen-mode #left-margin,
  body.zen-mode #right-margin,
  body.zen-mode header:not(article header),
  body.zen-mode footer {
    opacity: 0;
    pointer-events: none;
  }

  body.zen-mode #zen-toggle {
    opacity: 0.3;
  }

  body.zen-mode #zen-toggle:hover {
    opacity: 1;
  }

  body.zen-mode #progress-bar {
    height: 2px;
    background: var(--color-cinnabar);
  }
</style>

<script>
  const progressBar = document.getElementById('progress-bar');
  const zenBtn = document.getElementById('zen-btn');

  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = (scrollTop / docHeight) * 100;
    if (progressBar) {
      progressBar.style.width = `${progress}%`;
    }
  });

  function getCurrentLang(): 'en' | 'zh' {
    return localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  }

  zenBtn?.addEventListener('click', () => {
    document.body.classList.toggle('zen-mode');
    const icon = zenBtn.querySelector('.material-symbols-outlined');
    const text = zenBtn.querySelector('.i18n');
    const lang = getCurrentLang();
    if (document.body.classList.contains('zen-mode')) {
      if (icon) icon.textContent = 'visibility';
      if (text) text.textContent = lang === 'zh' ? '退出禅定' : 'Exit Zen';
    } else {
      if (icon) icon.textContent = 'visibility_off';
      if (text) text.textContent = lang === 'zh' ? '禅定模式' : 'Zen Mode';
    }
  });

  // i18n support
  function updateI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
  }

  const savedLang = getCurrentLang();
  updateI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateI18n(customEvent.detail.lang);
  });
</script>
