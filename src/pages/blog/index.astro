---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 获取所有博客文章
const blogEntries = await getCollection('blog');

// 按发布日期降序排序
const sortedEntries = blogEntries.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// 辅助函数：公历转农历年（简化版，基于年份）
function getLunarYear(dateStr: string): string {
  const year = new Date(dateStr).getFullYear();
  const heavenlyStems = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
  const earthlyBranches = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
  const stemIndex = (year - 4) % 10;
  const branchIndex = (year - 4) % 12;
  return `${heavenlyStems[stemIndex]}${earthlyBranches[branchIndex]}年`;
}

// 辅助函数：格式化日期为 "01 Mar 2026" 格式
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const day = date.getDate().toString().padStart(2, '0');
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
}

// 辅助函数：根据 element 推断 trigram
function getTrigram(element?: string): string {
  const elementToTrigram: Record<string, string> = {
    'water': 'water',
    'fire': 'fire',
    'wood': 'wind',
    'metal': 'heaven',
    'earth': 'mountain',
  };
  return elementToTrigram[element || 'earth'] || 'earth';
}

// 辅助函数：获取卦象标题
function getHexagramTitle(hexagram?: string): string {
  const hexagramTitles: Record<string, string> = {
    '䷀': 'The Creative',
    '䷁': 'The Receptive',
    '䷜': 'The Abysmal',
    '䷝': 'The Clinging',
    '䷰': 'Fluidity',
  };
  return hexagramTitles[hexagram || '䷁'] || 'The Way';
}

// 辅助函数：根据标签生成边注
function getMarginNote(tags: string[], title: string): string {
  const tagNotes: Record<string, string> = {
    'DeFi': 'x × y = k',
    'AMM': 'Δy = y·Δx/(x+Δx)',
    'Curve': 'χ = A × 4xy/D²',
    'Go': 'GC Latency < 1ms',
    'AI': 'LR = 0.001 decay',
    'Cryptography': 'P(x) where x is null',
    'ZKProofs': 'π ∈ {0,1}*',
    'Solidity': 'require(success)',
    'Web3': 'keccak256(data)',
    'Ethics': 'Moral calculus',
    'Oracle': 'median(sources)',
  };
  for (const tag of tags) {
    if (tagNotes[tag]) return tagNotes[tag];
  }
  return '道可道，非常道';
}

// 辅助函数：生成 AI 批注
function getAiAnnotation(tags: string[], element?: string): { code: string; comment: string } {
  const annotations: Record<string, { code: string; comment: string }> = {
    'DeFi': { code: 'getAmountOut()', comment: '流动性如水，自然流向阻力最小之处——AMM 不过是将这一自然法则形式化。' },
    'AMM': { code: 'swap()', comment: '交换的本质是平衡的重建，每一次交易都在寻找新的均衡点。' },
    'Curve': { code: 'get_dy()', comment: '曲线的弯曲程度，决定了流动性的深浅——StableSwap 在平衡中寻找最优。' },
    'Go': { code: 'runtime.GC()', comment: '此处调用显式GC，违背了"无为"原则。让运行时自行决定更符合道。' },
    'AI': { code: 'optimizer.step()', comment: '梯度下降如水向低处流，自然而然地找到最优解。' },
    'Cryptography': { code: 'prove(witness)', comment: '知而不言，言而不尽——零知识证明是密码学的"玄之又玄"。' },
    'ZKProofs': { code: 'verify(proof)', comment: '验证而不揭示，这是信任的最高形式。' },
    'Solidity': { code: 'revert()', comment: '回滚状态如同时间倒流，但链上的痕迹永存——这是区块链的"业力"。' },
    'Web3': { code: 'emit Event()', comment: '事件如涟漪，从链上扩散到链下，连接两个世界。' },
    'Ethics': { code: 'agent.decide()', comment: '机器的决策是否有"心"？无心之行，是否仍需承担因果？' },
    'Oracle': { code: 'aggregate()', comment: '众口铄金，多源聚合——去中心化预言机的智慧在于不信任任何单一来源。' },
  };
  for (const tag of tags) {
    if (annotations[tag]) return annotations[tag];
  }
  const elementAnnotations: Record<string, { code: string; comment: string }> = {
    'water': { code: 'flow()', comment: '上善若水，水善利万物而不争。' },
    'fire': { code: 'ignite()', comment: '火之道，在于转化与升华。' },
    'wood': { code: 'grow()', comment: '木之德，在于生生不息。' },
    'metal': { code: 'forge()', comment: '金之性，在于坚韧与锋利。' },
    'earth': { code: 'ground()', comment: '土之厚，在于承载万物。' },
  };
  return elementAnnotations[element || 'earth'] || { code: 'dao()', comment: '道法自然。' };
}

// 从文件路径提取 slug
function getSlug(id: string): string {
  // id 格式如 "curve-stableswap-formula/index" 或 "curve-stableswap-formula"
  return id.replace(/\/index$/, '').split('/')[0];
}

// 转换为页面需要的格式
const articles = sortedEntries.map(entry => ({
  title: entry.data.title,
  description: entry.data.description,
  date: formatDate(entry.data.pubDate),
  lunarYear: getLunarYear(entry.data.pubDate),
  tags: entry.data.tags,
  element: entry.data.element || 'earth',
  trigram: getTrigram(entry.data.element),
  hexagram: entry.data.hexagram || '䷁',
  hexagramTitle: getHexagramTitle(entry.data.hexagram),
  marginNote: getMarginNote(entry.data.tags, entry.data.title),
  slug: getSlug(entry.id),
  aiAnnotation: getAiAnnotation(entry.data.tags, entry.data.element),
}));

const elements = [
  { char: '金', name: 'Metal (Architecture)', nameZh: '金 (架构)', count: 12 },
  { char: '木', name: 'Wood (Growth/Go)', nameZh: '木 (成长/Go)', count: 8 },
  { char: '水', name: 'Water (Flow/AI)', nameZh: '水 (流动/AI)', count: 15 },
  { char: '火', name: 'Fire (Crypto/Web3)', nameZh: '火 (加密/Web3)', count: 23 },
  { char: '土', name: 'Earth (Foundation)', nameZh: '土 (基础)', count: 5 },
];

const trigrams = [
  { name: 'All', nameZh: '全部', type: 'all', symbol: '☯', desc: 'Show all writings', descZh: '显示所有文章', effect: 'none' },
  { name: 'Heaven', nameZh: '乾', type: 'heaven', symbol: '☰', desc: 'Architecture & Systems', descZh: '架构与系统', effect: 'none' },
  { name: 'Fire', nameZh: '离', type: 'fire', symbol: '☲', desc: 'High Performance', descZh: '高性能', effect: 'heat' },
  { name: 'Water', nameZh: '坎', type: 'water', symbol: '☵', desc: 'Privacy & Cryptography', descZh: '隐私与密码学', effect: 'ripple' },
  { name: 'Thunder', nameZh: '震', type: 'thunder', symbol: '☳', desc: 'Blockchain & Web3', descZh: '区块链与 Web3', effect: 'shake' },
  { name: 'Wind', nameZh: '巽', type: 'wind', symbol: '☴', desc: 'AI & Machine Learning', descZh: 'AI 与机器学习', effect: 'sway' },
  { name: 'Mountain', nameZh: '艮', type: 'mountain', symbol: '☶', desc: 'Philosophy & Ethics', descZh: '哲学与伦理', effect: 'none' },
  { name: 'Earth', nameZh: '坤', type: 'earth', symbol: '☷', desc: 'Foundation & Basics', descZh: '基础与入门', effect: 'none' },
];

const sexagenaryCycle = [
  '甲子', '乙丑', '丙寅', '丁卯', '戊辰', '己巳', '庚午', '辛未', '壬申', '癸酉',
  '甲戌', '乙亥', '丙子', '丁丑', '戊寅', '己卯', '庚辰', '辛巳', '壬午', '癸未',
  '甲申', '乙酉', '丙戌', '丁亥', '戊子', '己丑', '庚寅', '辛卯', '壬辰', '癸巳',
  '甲午', '乙未', '丙申', '丁酉', '戊戌', '己亥', '庚子', '辛丑', '壬寅', '癸卯',
  '甲辰', '乙巳', '丙午', '丁未', '戊申', '己酉', '庚戌', '辛亥', '壬子', '癸丑',
  '甲寅', '乙卯', '丙辰', '丁巳', '戊午', '己未', '庚申', '辛酉', '壬戌', '癸亥'
];
---

<Layout title="论道 - Logic" description="Writings on Web3, Go, and AI Ethics" currentPage="blog">
  <main class="relative z-10 flex-grow w-full max-w-6xl mx-auto px-6 py-10">
  <!-- Page Header -->
  <section class="w-full mb-8">
    <span class="i18n font-mono text-jade text-xs tracking-widest uppercase mb-2 block" data-en="Writings on Web3, Go, and AI Ethics" data-zh="关于 Web3、Go 和 AI 伦理的文章">
      Writings on Web3, Go, and AI Ethics
    </span>
    <h1 class="font-display font-black text-4xl md:text-5xl text-text-main tracking-tight mb-2">
      论道
    </h1>
    <p class="i18n font-display text-base text-text-subtle italic" data-en="Discoursing the Way" data-zh="论道之道">
      Discoursing the Way
    </p>
  </section>
  
  <!-- Trigram Filters -->
  <div class="w-full mb-10 relative">
    <div class="flex flex-wrap gap-3 items-center justify-center md:justify-start border-b border-text-main/10 pb-6">
      <span class="i18n font-mono text-xs uppercase tracking-widest text-text-subtle mr-2" data-en="Filter by Trigram:" data-zh="按卦象筛选:">Filter by Trigram:</span>
      {trigrams.map((trigram) => (
        <button 
          class={`bagua-filter group relative flex flex-col items-center gap-1 p-3 rounded-lg hover:bg-jade/5 transition-all duration-300 border border-transparent hover:border-jade/20 ${trigram.effect === 'heat' ? 'heat-effect' : ''} ${trigram.effect === 'ripple' ? 'ripple-effect' : ''} ${trigram.effect === 'shake' ? 'shake-effect' : ''} ${trigram.effect === 'sway' ? 'sway-effect' : ''}`}
          data-type={trigram.type}
          data-desc={trigram.desc}
          data-desc-zh={trigram.descZh}
          data-effect={trigram.effect}
          title={trigram.desc}
        >
          <span class="trigram-symbol text-2xl text-text-main group-hover:text-jade transition-colors duration-300 group-hover:scale-110 transform">
            {trigram.symbol}
          </span>
          <span class="i18n text-[9px] font-mono uppercase tracking-wider text-text-subtle group-hover:text-jade transition-colors" data-en={trigram.name} data-zh={trigram.nameZh}>
            {trigram.name}
          </span>
          <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap bg-text-main text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-30">
            {trigram.desc}
          </div>
        </button>
      ))}
    </div>
    
    <!-- Active Filter Indicator -->
    <div id="active-filter" class="mt-4 hidden">
      <span class="inline-flex items-center gap-2 bg-jade/10 text-jade px-3 py-1 rounded-full text-xs font-mono">
        <span id="filter-symbol"></span>
        <span id="filter-name"></span>
        <button id="clear-filter" class="hover:text-cinnabar transition-colors">×</button>
      </span>
    </div>
  </div>
  
  <!-- Main Content Grid -->
  <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-10">
    <!-- Articles List -->
    <div class="lg:col-span-8 flex flex-col gap-8 article-list">
      {articles.map((article) => {
        const [day, month, year] = article.date.split(' ');
        return (
          <article class="bamboo-slip pb-6 group cursor-pointer relative pr-6 lg:pr-12" data-element={article.element} data-trigram={article.trigram}>
            <a href={`/blog/${article.slug}`} class="article-link absolute inset-0 z-10"></a>
            
            <!-- Original Marginalia -->
            <div class="marginalia">
              <span class="hexagram" title={article.hexagramTitle}>{article.hexagram}</span>
              <span>{article.marginNote}</span>
            </div>
            
            <!-- AI Annotation (朱墨批注) -->
            <div class="ai-annotation hidden lg:block">
              <div class="annotation-header">
                <span class="material-symbols-outlined text-xs">psychology</span>
                <span class="i18n" data-en="AI Annotation" data-zh="AI 批注">AI 批注</span>
              </div>
              <code class="annotation-code">{article.aiAnnotation.code}</code>
              <p class="annotation-comment">{article.aiAnnotation.comment}</p>
            </div>
            
            <div class="flex flex-col md:flex-row gap-4 md:gap-8 items-start">
              <div class="date-column md:w-20 shrink-0 flex flex-row md:flex-col items-baseline md:items-start md:text-right border-l-4 md:border-l-0 md:border-r-2 border-jade/20 pl-3 md:pl-0 md:pr-3 md:py-1 relative cursor-pointer z-20" data-lunar={article.lunarYear}>
                <div class="hidden md:block absolute right-[-2px] top-6 w-[2px] bg-jade time-layer z-10 origin-top"></div>
                <span class="font-display text-2xl font-bold text-text-main leading-none w-full text-right">{day}</span>
                <div class="flex flex-col md:items-end w-full">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-text-main">{month} {year}</span>
                  <div class="flex flex-col items-end">
                    <span class="font-display text-sm text-jade mt-0.5 lunar-year-display">{article.lunarYear}</span>
                    <div class="tps-wave mt-1" title="Current Network TPS">
                      <div class="bar h-2"></div>
                      <div class="bar h-3"></div>
                      <div class="bar h-2"></div>
                      <div class="bar h-1"></div>
                      <div class="bar h-2"></div>
                    </div>
                  </div>
                </div>
                <!-- Sexagenary Cycle Timeline (Hidden by default) -->
                <div class="cycle-timeline hidden absolute left-full top-0 ml-4 bg-white border border-jade/20 rounded-lg p-4 shadow-xl z-50 w-64">
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-display text-sm font-bold text-text-main">六十甲子周期</span>
                    <button class="close-timeline text-text-subtle hover:text-cinnabar">
                      <span class="material-symbols-outlined text-sm">close</span>
                    </button>
                  </div>
                  <div class="cycle-wheel relative h-32 mb-3">
                    <div class="absolute inset-0 flex items-center justify-center">
                      <div class="w-24 h-24 rounded-full border-2 border-jade/20 flex items-center justify-center">
                        <span class="font-display text-2xl text-jade current-cycle">{article.lunarYear.slice(0, 2)}</span>
                      </div>
                    </div>
                    <div class="cycle-markers absolute inset-0">
                      <span class="absolute top-0 left-1/2 -translate-x-1/2 text-[10px] font-mono text-text-subtle">子</span>
                      <span class="absolute bottom-0 left-1/2 -translate-x-1/2 text-[10px] font-mono text-text-subtle">午</span>
                      <span class="absolute left-0 top-1/2 -translate-y-1/2 text-[10px] font-mono text-text-subtle">卯</span>
                      <span class="absolute right-0 top-1/2 -translate-y-1/2 text-[10px] font-mono text-text-subtle">酉</span>
                    </div>
                  </div>
                  <p class="text-[10px] text-text-subtle font-mono text-center">
                    Non-linear time perception in Taoist cosmology
                  </p>
                </div>
              </div>
              <div class="flex-grow">
                <h2 class="font-display text-xl md:text-2xl font-bold text-text-main mb-2 group-hover:text-jade transition-colors duration-300 leading-tight ink-title">
                  {article.title}
                </h2>
                <p class="text-text-subtle font-body mb-3 text-sm leading-relaxed">
                  {article.description}
                </p>
                <div class="flex flex-wrap gap-3 items-center">
                  {article.tags.map((tag, i) => (
                    <>
                      <span class="font-mono text-xs text-jade/80">#{tag}</span>
                      {i < article.tags.length - 1 && <span class="w-1 h-1 rounded-full bg-text-subtle/30"></span>}
                    </>
                  ))}
                </div>
              </div>
            </div>
          </article>
        );
      })}
      
      <!-- Pagination -->
      <div class="flex items-center justify-center gap-8 mt-8 pt-8 border-t border-dashed border-text-main/10">
        <button class="text-text-subtle hover:text-jade font-mono text-sm uppercase flex items-center gap-2 transition-colors disabled:opacity-50" disabled>
          <span class="material-symbols-outlined text-lg">west</span>
          <span class="i18n" data-en="Previous" data-zh="上一页">Previous</span>
        </button>
        <span class="font-display text-lg text-text-main">1 / 5</span>
        <button class="text-text-main hover:text-jade font-mono text-sm uppercase flex items-center gap-2 transition-colors">
          <span class="i18n" data-en="Next" data-zh="下一页">Next</span>
          <span class="material-symbols-outlined text-lg">east</span>
        </button>
      </div>
    </div>
    
    <!-- Sidebar -->
    <aside class="lg:col-span-4 lg:pl-8 flex flex-col gap-10 mt-8 lg:mt-0">
      <!-- Search -->
      <div class="relative group hidden md:block">
        <p class="i18n font-mono text-xs text-text-subtle mb-2" data-en="Keyboard shortcut: '/' to search" data-zh="快捷键: '/' 搜索">Keyboard shortcut: '/' to search</p>
        <div class="i18n w-full bg-transparent border-b border-text-main/20 py-2 pl-0 pr-8 text-text-main font-mono text-sm opacity-50 cursor-not-allowed" data-en="Press / to search..." data-zh="按 / 搜索...">
          Press / to search...
        </div>
        <span class="material-symbols-outlined absolute right-0 top-8 text-text-subtle">search</span>
      </div>
      
      <!-- Elements -->
      <div>
        <h3 class="font-display text-lg font-bold text-text-main mb-4 flex items-center gap-2">
          <span class="w-1 h-4 bg-jade"></span>
          <span class="i18n" data-en="Elements" data-zh="五行分类">Elements</span>
        </h3>
        <ul class="space-y-3">
          {elements.map((el) => (
            <li>
              <a href="#" class="group flex items-center justify-between hover:bg-white/50 p-2 -mx-2 rounded transition-colors">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full border border-text-main/10 flex items-center justify-center text-text-subtle font-display text-sm group-hover:border-jade group-hover:text-jade transition-colors">{el.char}</div>
                  <span class="i18n font-mono text-sm text-text-main group-hover:text-jade transition-colors" data-en={el.name} data-zh={el.nameZh}>{el.name}</span>
                </div>
                <span class="text-xs font-mono text-text-subtle">{el.count.toString().padStart(2, '0')}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Newsletter -->
      <div class="border-t border-dashed border-text-main/10 pt-6">
        <h3 class="i18n font-display text-sm font-bold text-text-main mb-3 uppercase tracking-wider" data-en="Signals" data-zh="订阅">Signals</h3>
        <p class="i18n text-xs text-text-subtle mb-4 font-mono" data-en="Subscribe for monthly transmissions." data-zh="订阅月度通讯">Subscribe for monthly transmissions.</p>
        <div class="flex gap-2">
          <input type="email" placeholder="Email" class="w-full bg-white/50 border border-text-main/10 py-2 px-3 text-text-main font-mono text-xs focus:outline-none focus:border-jade transition-colors rounded-sm" />
          <button class="i18n bg-text-main text-white px-3 py-2 text-xs font-mono hover:bg-jade transition-colors rounded-sm" data-en="Join" data-zh="加入">Join</button>
        </div>
      </div>
    </aside>
  </div>
  </main>
</Layout>

<style>
  .marginalia {
    font-family: 'Noto Serif SC', serif;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    position: absolute;
    right: -3rem;
    top: 2rem;
    height: auto;
    max-height: 80%;
    color: #B33939;
    font-size: 0.7rem;
    opacity: 0.7;
    border-right: 1px solid rgba(179, 57, 57, 0.2);
    padding-right: 0.5rem;
    letter-spacing: 0.1em;
    pointer-events: none;
    display: none;
    line-height: 1.5;
    z-index: 20;
  }
  
  @media (min-width: 1280px) {
    .marginalia {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
  
  .hexagram {
    font-size: 1.25rem;
    line-height: 1;
    margin-bottom: 0.25rem;
    writing-mode: horizontal-tb;
    display: inline-block;
  }

  /* AI Annotation (朱墨批注) */
  .ai-annotation {
    position: absolute;
    right: -12rem;
    top: 0;
    width: 10rem;
    padding: 0.75rem;
    background: linear-gradient(135deg, rgba(179, 57, 57, 0.03) 0%, transparent 100%);
    border-left: 2px solid rgba(179, 57, 57, 0.2);
    opacity: 0;
    transform: translateX(10px);
    transition: all 0.4s ease;
    pointer-events: none;
    z-index: 25;
  }

  .bamboo-slip:hover .ai-annotation {
    opacity: 1;
    transform: translateX(0);
  }

  .annotation-header {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: #B33939;
    font-size: 0.6rem;
    font-family: 'Noto Serif SC', serif;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .annotation-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #B33939;
    background: rgba(179, 57, 57, 0.08);
    padding: 0.25rem 0.5rem;
    border-radius: 0.125rem;
    margin-bottom: 0.5rem;
  }

  .annotation-comment {
    font-family: 'Noto Serif SC', serif;
    font-size: 0.7rem;
    color: #8B4513;
    line-height: 1.6;
    margin: 0;
    font-style: italic;
  }

  /* Heat Effect for Fire Trigram */
  .heat-effect:hover .trigram-symbol {
    animation: heat-distort 0.3s ease-in-out infinite;
    color: #D13429;
    text-shadow: 0 0 10px rgba(209, 52, 41, 0.5);
  }

  @keyframes heat-distort {
    0%, 100% { transform: scale(1.1) skewX(0deg); }
    25% { transform: scale(1.12) skewX(1deg); }
    75% { transform: scale(1.08) skewX(-1deg); }
  }

  /* Ripple Effect for Water Trigram */
  .ripple-effect:hover .trigram-symbol {
    animation: water-ripple 1s ease-in-out infinite;
    color: #4A8B71;
  }

  @keyframes water-ripple {
    0%, 100% { transform: scale(1.1); opacity: 1; }
    50% { transform: scale(1.15); opacity: 0.8; }
  }

  .ripple-effect:hover::after {
    content: '';
    position: absolute;
    inset: -10px;
    border: 1px solid rgba(74, 139, 113, 0.3);
    border-radius: 50%;
    animation: ripple-expand 1s ease-out infinite;
  }

  @keyframes ripple-expand {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* Shake Effect for Thunder Trigram */
  .shake-effect:hover .trigram-symbol {
    animation: thunder-shake 0.1s ease-in-out infinite;
    color: #8B5A2B;
  }

  @keyframes thunder-shake {
    0%, 100% { transform: translateX(0) scale(1.1); }
    25% { transform: translateX(-2px) scale(1.1); }
    75% { transform: translateX(2px) scale(1.1); }
  }

  /* Sway Effect for Wind Trigram */
  .sway-effect:hover .trigram-symbol {
    animation: wind-sway 2s ease-in-out infinite;
    color: #6B8E6B;
  }

  @keyframes wind-sway {
    0%, 100% { transform: rotate(-3deg) scale(1.1); }
    50% { transform: rotate(3deg) scale(1.1); }
  }

  .bagua-filter.active {
    background: rgba(74, 140, 114, 0.1);
    border-color: rgba(74, 140, 114, 0.3);
  }

  .bagua-filter.active span:first-child {
    color: var(--color-jade);
    transform: scale(1.2);
  }

  .bamboo-slip {
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .bamboo-slip.filtered-out {
    opacity: 0.15;
    transform: scale(0.98);
    pointer-events: none;
  }

  .bamboo-slip.filtered-in {
    animation: ink-reveal 0.5s ease-out;
  }

  @keyframes ink-reveal {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* Date Column Hover */
  .date-column {
    transition: all 0.3s ease;
  }

  .date-column:hover {
    border-color: rgba(74, 140, 114, 0.5);
  }

  .date-column:hover .lunar-year-display {
    text-decoration: underline;
    text-decoration-style: dotted;
  }

  /* Cycle Timeline Animation */
  .cycle-timeline {
    animation: timeline-appear 0.3s ease-out;
  }

  @keyframes timeline-appear {
    0% { opacity: 0; transform: translateX(-10px); }
    100% { opacity: 1; transform: translateX(0); }
  }

  .cycle-wheel .current-cycle {
    animation: cycle-pulse 2s ease-in-out infinite;
  }

  @keyframes cycle-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }
</style>

<script>
  const filters = document.querySelectorAll('.bagua-filter');
  const articles = document.querySelectorAll('.bamboo-slip');
  const activeFilterEl = document.getElementById('active-filter');
  const filterSymbol = document.getElementById('filter-symbol');
  const filterName = document.getElementById('filter-name');
  const clearFilter = document.getElementById('clear-filter');

  let currentFilter = 'all';

  function applyFilter(type: string, symbol: string, name: string, event?: MouseEvent) {
    currentFilter = type;

    filters.forEach(f => {
      f.classList.toggle('active', f.getAttribute('data-type') === type);
    });

    articles.forEach(article => {
      const articleTrigram = article.getAttribute('data-trigram');
      if (type === 'all' || articleTrigram === type) {
        article.classList.remove('filtered-out');
        article.classList.add('filtered-in');
      } else {
        article.classList.add('filtered-out');
        article.classList.remove('filtered-in');
      }
    });

    if (type === 'all') {
      activeFilterEl?.classList.add('hidden');
    } else {
      activeFilterEl?.classList.remove('hidden');
      if (filterSymbol) filterSymbol.textContent = symbol;
      if (filterName) filterName.textContent = name;
    }
  }

  filters.forEach(filter => {
    filter.addEventListener('click', (e) => {
      const type = filter.getAttribute('data-type') || 'all';
      const symbol = filter.querySelector('.trigram-symbol')?.textContent || '☯';
      const name = filter.querySelector('span:last-of-type')?.textContent || 'All';
      applyFilter(type, symbol, name, e as MouseEvent);
    });
  });

  clearFilter?.addEventListener('click', () => {
    applyFilter('all', '☯', 'All');
  });

  // Date column click to show timeline
  document.querySelectorAll('.date-column').forEach(col => {
    col.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      // Close all other timelines
      document.querySelectorAll('.cycle-timeline').forEach(t => t.classList.add('hidden'));
      
      const timeline = col.querySelector('.cycle-timeline');
      timeline?.classList.toggle('hidden');
    });
  });

  // Close timeline buttons
  document.querySelectorAll('.close-timeline').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const timeline = (e.target as HTMLElement).closest('.cycle-timeline');
      timeline?.classList.add('hidden');
    });
  });

  // Close timeline when clicking outside
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.date-column')) {
      document.querySelectorAll('.cycle-timeline').forEach(t => t.classList.add('hidden'));
    }
  });

  // i18n support
  function updateI18n(lang: 'en' | 'zh') {
    document.querySelectorAll('.i18n').forEach(el => {
      const htmlEl = el as HTMLElement;
      const text = lang === 'zh' ? htmlEl.dataset.zh : htmlEl.dataset.en;
      if (text) {
        htmlEl.textContent = text;
      }
    });
  }

  const savedLang = localStorage.getItem('cyber-zen-lang') as 'en' | 'zh' || 'en';
  updateI18n(savedLang);

  window.addEventListener('langchange', (e: Event) => {
    const customEvent = e as CustomEvent;
    updateI18n(customEvent.detail.lang);
  });
</script>
